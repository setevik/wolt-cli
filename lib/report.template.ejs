<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wolt Expense Report<%= meta.demo ? ' (demo)' : '' %></title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.js"></script>
    <style>
        /* ------------------------------------------------------------------
           Design tokens
           One neutral scale, one accent, a fixed categorical palette for
           chart series (validated for colour-vision deficiency), and a
           4px spacing grid. Everything below references these tokens.
           ------------------------------------------------------------------ */
        :root {
            color-scheme: light;
            --page: #f4f4f1;
            --surface: #fcfcfb;
            --surface-2: #f4f4f1;
            --ink: #0b0b0b;
            --ink-2: #52514e;
            --ink-3: #6f6e69;
            --line: rgba(11, 11, 11, 0.10);
            --grid: #e1e0d9;
            --axis: #c3c2b7;
            --accent: #2a78d6;
            --accent-ink: #1c5cab;
            --accent-wash: rgba(42, 120, 214, 0.10);
            --on-accent: #ffffff;
            --up: #b42f2f;      /* spending went up */
            --down: #006300;    /* spending went down */

            /* Chart series, in fixed order */
            --series-1: #2a78d6;
            --series-2: #eb6834;
            --series-3: #1baf7a;
            --series-4: #eda100;
            --series-5: #e87ba4;
            --series-6: #008300;
            --series-7: #4a3aa7;
            --series-8: #e34948;
            /* Fees are overhead, not a category: neutral */
            --fee-1: #52514e;
            --fee-2: #a3a29b;
            --fee-3: #cfcec7;

            /* Sequential (heatmap) */
            --seq-0: #ebeae5;
            --seq-1: #b7d3f6;
            --seq-2: #6da7ec;
            --seq-3: #2a78d6;
            --seq-4: #184f95;

            --font: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            --fs-xs: 12px;
            --fs-sm: 13px;
            --fs-md: 14px;
            --fs-lg: 16px;
            --fs-xl: 20px;
            --fs-2xl: 28px;
            --fs-3xl: 44px;

            --s-1: 4px;
            --s-2: 8px;
            --s-3: 12px;
            --s-4: 16px;
            --s-5: 20px;
            --s-6: 24px;
            --s-8: 32px;
            --s-10: 40px;

            --radius-sm: 6px;
            --radius: 10px;
            --radius-lg: 14px;
            --shadow: 0 1px 2px rgba(11, 11, 11, 0.04);
        }

        :root[data-theme="dark"] {
            color-scheme: dark;
            --page: #0d0d0d;
            --surface: #1a1a19;
            --surface-2: #232322;
            --ink: #ffffff;
            --ink-2: #c3c2b7;
            --ink-3: #9a9992;
            --line: rgba(255, 255, 255, 0.10);
            --grid: #2c2c2a;
            --axis: #383835;
            --accent: #3987e5;
            --accent-ink: #86b6ef;
            --accent-wash: rgba(57, 135, 229, 0.16);
            --up: #e66767;
            --down: #0ca30c;

            --series-1: #3987e5;
            --series-2: #d95926;
            --series-3: #199e70;
            --series-4: #c98500;
            --series-5: #d55181;
            --series-6: #008300;
            --series-7: #9085e9;
            --series-8: #e66767;
            --fee-1: #c3c2b7;
            --fee-2: #7d7c76;
            --fee-3: #4a4a47;

            --seq-0: #262625;
            --seq-1: #184f95;
            --seq-2: #256abf;
            --seq-3: #3987e5;
            --seq-4: #86b6ef;
            --shadow: none;
        }

        /* ------------------------------------------------------------------
           Base
           ------------------------------------------------------------------ */
        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: var(--font);
            font-size: var(--fs-md);
            line-height: 1.5;
            color: var(--ink);
            background: var(--page);
            -webkit-font-smoothing: antialiased;
        }

        button, input, select { font: inherit; color: inherit; }

        :focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        .num { font-variant-numeric: tabular-nums; }
        .muted { color: var(--ink-3); }
        .visually-hidden {
            position: absolute; width: 1px; height: 1px; overflow: hidden;
            clip: rect(0 0 0 0); white-space: nowrap;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: var(--s-8) var(--s-6) var(--s-10);
        }

        /* ------------------------------------------------------------------
           Header & navigation
           ------------------------------------------------------------------ */
        .demo-banner {
            display: flex;
            gap: var(--s-2);
            align-items: center;
            justify-content: center;
            padding: var(--s-2) var(--s-4);
            background: var(--accent-wash);
            color: var(--accent-ink);
            font-size: var(--fs-sm);
            text-align: center;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: var(--s-4);
            flex-wrap: wrap;
            margin-bottom: var(--s-6);
        }

        .eyebrow {
            font-size: var(--fs-xs);
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--ink-3);
            margin: 0 0 var(--s-1);
        }

        .header h1 {
            margin: 0;
            font-size: var(--fs-2xl);
            font-weight: 650;
            letter-spacing: -0.01em;
        }

        .header-meta {
            margin: var(--s-1) 0 0;
            color: var(--ink-2);
            font-size: var(--fs-sm);
        }

        .header-actions {
            display: flex;
            gap: var(--s-2);
            align-items: center;
        }

        .control {
            height: 36px;
            padding: 0 var(--s-3);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            background: var(--surface);
            color: var(--ink);
            font-size: var(--fs-sm);
            cursor: pointer;
        }

        .control:hover { background: var(--surface-2); }

        .icon-btn {
            width: 36px;
            padding: 0;
            display: inline-grid;
            place-items: center;
        }

        .icon-btn svg { width: 18px; height: 18px; }
        .icon-sun { display: none; }
        [data-theme="dark"] .icon-sun { display: block; }
        [data-theme="dark"] .icon-moon { display: none; }

        .currency-field {
            display: flex;
            align-items: center;
            gap: var(--s-2);
            font-size: var(--fs-sm);
            color: var(--ink-2);
        }

        .currency-field[hidden] { display: none; }

        .tabs {
            display: flex;
            gap: var(--s-6);
            border-bottom: 1px solid var(--line);
            margin-bottom: var(--s-8);
        }

        .tab-btn {
            position: relative;
            padding: var(--s-2) 0 var(--s-3);
            border: 0;
            background: none;
            color: var(--ink-2);
            font-weight: 500;
            cursor: pointer;
        }

        .tab-btn:hover { color: var(--ink); }

        .tab-btn[aria-selected="true"] { color: var(--ink); }

        .tab-btn[aria-selected="true"]::after {
            content: "";
            position: absolute;
            left: 0; right: 0; bottom: -1px;
            height: 2px;
            background: var(--accent);
            border-radius: 2px;
        }

        .tab-count {
            margin-left: var(--s-1);
            color: var(--ink-3);
            font-weight: 400;
        }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        /* ------------------------------------------------------------------
           Layout primitives
           ------------------------------------------------------------------ */
        .section { margin-bottom: var(--s-8); }

        .section-head { margin-bottom: var(--s-4); }

        .section-title {
            margin: 0;
            font-size: var(--fs-lg);
            font-weight: 600;
        }

        .section-desc {
            margin: 2px 0 0;
            color: var(--ink-3);
            font-size: var(--fs-sm);
        }

        .card {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow);
            padding: var(--s-6);
        }

        .grid-2 {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: var(--s-6);
        }

        .grid-2 > .section { margin-bottom: 0; }
        .grid-2 + .section, .grid-2 + .grid-2 { margin-top: var(--s-8); }

        .chart-box { position: relative; height: 280px; }
        .chart-box.tall { height: 340px; }

        .chart-fallback {
            display: grid;
            place-items: center;
            height: 100%;
            color: var(--ink-3);
            font-size: var(--fs-sm);
            text-align: center;
        }

        .legend {
            display: flex;
            flex-wrap: wrap;
            gap: var(--s-2) var(--s-4);
            margin: 0 0 var(--s-4);
            padding: 0;
            list-style: none;
            font-size: var(--fs-sm);
            color: var(--ink-2);
        }

        .legend li { display: inline-flex; align-items: center; gap: 6px; }

        .swatch {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 3px;
            flex-shrink: 0;
        }

        /* ------------------------------------------------------------------
           Summary: headline figure + KPI tiles
           ------------------------------------------------------------------ */
        .summary {
            display: grid;
            grid-template-columns: minmax(0, 1.3fr) repeat(2, minmax(0, 1fr));
            gap: var(--s-4);
        }

        .headline {
            grid-row: span 2;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: var(--s-6);
        }

        .stat-label {
            margin: 0 0 var(--s-2);
            font-size: var(--fs-xs);
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--ink-3);
        }

        .headline-value {
            margin: 0;
            font-size: var(--fs-3xl);
            font-weight: 650;
            letter-spacing: -0.02em;
            line-height: 1.05;
        }

        .headline-sub {
            margin: var(--s-2) 0 0;
            color: var(--ink-2);
        }

        .headline-facts {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: var(--s-4);
            padding-top: var(--s-5);
            border-top: 1px solid var(--line);
        }

        .fact-value {
            display: block;
            font-size: var(--fs-xl);
            font-weight: 600;
        }

        .fact-label {
            font-size: var(--fs-sm);
            color: var(--ink-3);
        }

        .kpi { padding: var(--s-5); }

        .kpi-value {
            margin: 0;
            font-size: var(--fs-2xl);
            font-weight: 650;
            letter-spacing: -0.01em;
            line-height: 1.15;
        }

        .kpi-sub {
            margin: var(--s-2) 0 0;
            font-size: var(--fs-sm);
            color: var(--ink-2);
        }

        .delta {
            display: inline-flex;
            align-items: center;
            gap: 2px;
            font-weight: 600;
        }

        .delta.up { color: var(--up); }
        .delta.down { color: var(--down); }

        /* ------------------------------------------------------------------
           Cost breakdown
           ------------------------------------------------------------------ */
        .split-bar {
            display: flex;
            gap: 2px;
            height: 14px;
            margin: var(--s-2) 0 var(--s-5);
        }

        .split-bar span:first-child { border-radius: 4px 0 0 4px; }
        .split-bar span:last-child { border-radius: 0 4px 4px 0; }
        .split-bar span:only-child { border-radius: 4px; }

        .rows {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .row {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto auto;
            align-items: center;
            gap: var(--s-3);
            padding: var(--s-3) 0;
            border-top: 1px solid var(--line);
        }

        .row:first-child { border-top: 0; }

        .row-label { color: var(--ink); }
        .row-value { font-weight: 600; text-align: right; }
        .row-pct { color: var(--ink-3); width: 48px; text-align: right; font-size: var(--fs-sm); }

        .callout {
            margin: var(--s-5) 0 0;
            padding: var(--s-3) var(--s-4);
            border-radius: var(--radius);
            background: var(--surface-2);
            color: var(--ink-2);
            font-size: var(--fs-sm);
        }

        .callout strong { color: var(--ink); }

        /* ------------------------------------------------------------------
           Ranked lists (venues, items)
           ------------------------------------------------------------------ */
        .rank-list {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .rank-item {
            display: grid;
            grid-template-columns: 24px minmax(0, 1fr) auto;
            gap: 2px var(--s-3);
            align-items: baseline;
            padding: var(--s-2) var(--s-2);
            margin: 0 calc(var(--s-2) * -1);
            border-radius: var(--radius-sm);
        }

        button.rank-item {
            width: calc(100% + var(--s-4));
            border: 0;
            background: none;
            text-align: left;
            cursor: pointer;
        }

        button.rank-item:hover { background: var(--surface-2); }

        .rank-pos { color: var(--ink-3); font-size: var(--fs-sm); }

        .rank-name {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-weight: 500;
        }

        .rank-value { font-weight: 600; text-align: right; }

        .rank-meta {
            grid-column: 2 / 4;
            display: flex;
            align-items: center;
            gap: var(--s-3);
            font-size: var(--fs-xs);
            color: var(--ink-3);
        }

        .rank-bar {
            flex: 1;
            height: 4px;
            border-radius: 2px;
            background: var(--grid);
            overflow: hidden;
        }

        .rank-bar span {
            display: block;
            height: 100%;
            border-radius: 2px;
            background: var(--accent);
        }

        .rank-meta-text { white-space: nowrap; min-width: 110px; text-align: right; }

        /* ------------------------------------------------------------------
           Heatmap
           ------------------------------------------------------------------ */
        .heatmap-scroll { overflow-x: auto; padding-bottom: var(--s-1); }

        .heatmap { display: inline-block; min-width: max-content; }

        .heatmap-months {
            position: relative;
            height: 18px;
            margin-left: 32px;
            font-size: var(--fs-xs);
            color: var(--ink-3);
        }

        .heatmap-months span { position: absolute; top: 0; }

        .heatmap-body { display: flex; }

        .heatmap-days {
            display: grid;
            grid-template-rows: repeat(7, 12px);
            row-gap: 3px;
            width: 32px;
            font-size: 10px;
            line-height: 12px;
            color: var(--ink-3);
        }

        .heatmap-weeks { display: flex; gap: 3px; }
        .heatmap-week { display: grid; grid-template-rows: repeat(7, 12px); row-gap: 3px; }

        .cell {
            width: 12px;
            height: 12px;
            border-radius: 3px;
            background: var(--seq-0);
        }

        .cell[data-level="1"] { background: var(--seq-1); }
        .cell[data-level="2"] { background: var(--seq-2); }
        .cell[data-level="3"] { background: var(--seq-3); }
        .cell[data-level="4"] { background: var(--seq-4); }
        .cell.empty { background: transparent; }
        .cell[data-date] { cursor: pointer; }
        .cell[data-date]:hover { outline: 2px solid var(--ink); outline-offset: 1px; }

        .heatmap-foot {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--s-4);
            margin-top: var(--s-4);
            padding-top: var(--s-4);
            border-top: 1px solid var(--line);
            font-size: var(--fs-sm);
            color: var(--ink-2);
        }

        .heatmap-stats { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); }
        .heatmap-stats strong { color: var(--ink); font-weight: 600; }

        .scale {
            display: flex;
            align-items: center;
            gap: 3px;
            font-size: var(--fs-xs);
            color: var(--ink-3);
        }

        .scale .cell { cursor: default; }
        .scale span:first-child { margin-right: var(--s-1); }
        .scale span:last-child { margin-left: var(--s-1); }

        .tooltip {
            position: fixed;
            z-index: 10;
            max-width: 280px;
            padding: var(--s-2) var(--s-3);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            background: var(--surface);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
            font-size: var(--fs-sm);
            pointer-events: none;
            display: none;
        }

        .tooltip.visible { display: block; }
        .tooltip-title { font-weight: 600; }
        .tooltip-body { color: var(--ink-2); }

        /* ------------------------------------------------------------------
           Habits (stat tiles) & places
           ------------------------------------------------------------------ */
        .tiles {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: var(--s-4);
        }

        .places-label {
            align-self: center;
            margin-right: var(--s-2);
            font-size: var(--fs-sm);
            color: var(--ink-3);
        }

        .tile { padding: var(--s-5); }

        .tile-value {
            margin: 0;
            font-size: var(--fs-xl);
            font-weight: 650;
            overflow-wrap: anywhere;
        }

        .tile-detail {
            margin: var(--s-1) 0 0;
            font-size: var(--fs-sm);
            color: var(--ink-3);
        }

        .places {
            display: flex;
            flex-wrap: wrap;
            gap: var(--s-2);
            margin: var(--s-4) 0 0;
            padding: 0;
            list-style: none;
        }

        .chip {
            display: inline-flex;
            align-items: baseline;
            gap: var(--s-2);
            padding: 6px var(--s-3);
            border: 1px solid var(--line);
            border-radius: 999px;
            background: var(--surface);
            font-size: var(--fs-sm);
        }

        .chip .muted { font-size: var(--fs-xs); }

        /* ------------------------------------------------------------------
           Orders tab
           ------------------------------------------------------------------ */
        .toolbar {
            display: flex;
            flex-direction: column;
            gap: var(--s-4);
            margin-bottom: var(--s-4);
        }

        .segmented {
            display: inline-flex;
            flex-wrap: wrap;
            gap: 2px;
            padding: 3px;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            background: var(--surface);
            width: fit-content;
            max-width: 100%;
        }

        .segmented button {
            padding: 6px var(--s-3);
            border: 0;
            border-radius: var(--radius-sm);
            background: none;
            color: var(--ink-2);
            font-size: var(--fs-sm);
            cursor: pointer;
        }

        .segmented button:hover { color: var(--ink); background: var(--surface-2); }

        .segmented button[aria-pressed="true"] {
            background: var(--ink);
            color: var(--surface);
        }

        .filters {
            display: flex;
            flex-wrap: wrap;
            gap: var(--s-3);
            align-items: flex-end;
        }

        .field { display: flex; flex-direction: column; gap: var(--s-1); }
        .field.grow { flex: 1; min-width: 220px; }

        .field label {
            font-size: var(--fs-xs);
            font-weight: 600;
            color: var(--ink-3);
        }

        .input {
            height: 36px;
            padding: 0 var(--s-3);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            background: var(--surface);
            color: var(--ink);
            font-size: var(--fs-md);
        }

        .input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-wash); }

        .btn {
            height: 36px;
            padding: 0 var(--s-4);
            border-radius: var(--radius-sm);
            border: 1px solid var(--line);
            background: var(--surface);
            color: var(--ink);
            font-size: var(--fs-sm);
            font-weight: 500;
            cursor: pointer;
        }

        .btn:hover { background: var(--surface-2); }

        .btn-primary {
            background: var(--accent);
            border-color: var(--accent);
            color: var(--on-accent);
        }

        .btn-primary:hover { background: var(--accent-ink); }

        .orders-summary {
            margin: 0 0 var(--s-3);
            color: var(--ink-2);
            font-size: var(--fs-sm);
        }

        .orders-summary strong { color: var(--ink); }

        .table-card { padding: 0; overflow-x: auto; }

        table { width: 100%; border-collapse: collapse; min-width: 720px; }

        th, td {
            padding: var(--s-3) var(--s-4);
            text-align: left;
            border-bottom: 1px solid var(--line);
            vertical-align: middle;
        }

        th {
            position: sticky;
            top: 0;
            background: var(--surface);
            font-size: var(--fs-xs);
            font-weight: 600;
            color: var(--ink-3);
            white-space: nowrap;
        }

        th.right, td.right { text-align: right; }

        th[data-sort] { cursor: pointer; user-select: none; }
        th[data-sort]:hover { color: var(--ink); }
        th[data-sort]::after { content: " \2195"; opacity: 0.35; }
        th[aria-sort="ascending"]::after { content: " \2191"; opacity: 1; }
        th[aria-sort="descending"]::after { content: " \2193"; opacity: 1; }

        tbody tr.order-row { cursor: pointer; }
        tbody tr.order-row:hover { background: var(--surface-2); }
        tbody tr:last-child td { border-bottom: 0; }

        .cell-items {
            max-width: 320px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: var(--ink-2);
        }

        .chevron {
            display: inline-block;
            width: 12px;
            margin-right: var(--s-2);
            color: var(--ink-3);
            transition: transform 0.15s;
        }

        .order-row[aria-expanded="true"] .chevron { transform: rotate(90deg); }

        .pill {
            display: inline-block;
            padding: 1px var(--s-2);
            border-radius: 999px;
            background: var(--surface-2);
            color: var(--ink-2);
            font-size: var(--fs-xs);
            white-space: nowrap;
        }

        .pill.negative { color: var(--up); }

        .type-dot { margin-right: 6px; vertical-align: 1px; }

        .details-row { display: none; background: var(--surface-2); }
        .details-row.open { display: table-row; }

        .details {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: var(--s-6);
            padding: var(--s-2) 0;
        }

        .details h4 {
            margin: 0 0 var(--s-2);
            font-size: var(--fs-xs);
            font-weight: 600;
            color: var(--ink-3);
        }

        .details dl {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: var(--s-1) var(--s-4);
            margin: 0;
        }

        .details dt { color: var(--ink-2); }
        .details dd { margin: 0; text-align: right; }
        .details dt.total, .details dd.total { font-weight: 600; color: var(--ink); padding-top: var(--s-1); border-top: 1px solid var(--line); }

        .empty-state {
            padding: var(--s-10) var(--s-4);
            text-align: center;
            color: var(--ink-3);
        }

        .footer {
            margin-top: var(--s-10);
            padding-top: var(--s-4);
            border-top: 1px solid var(--line);
            font-size: var(--fs-xs);
            color: var(--ink-3);
        }

        /* ------------------------------------------------------------------
           Embed mode (used by the project site to preview single sections)
           ------------------------------------------------------------------ */
        body.embed .demo-banner,
        body.embed .header,
        body.embed .tabs,
        body.embed .footer { display: none; }
        body.embed .container { padding: var(--s-4); }
        body.embed { background: transparent; }
        body[data-focus] [data-section] { display: none; }
        body[data-focus] .grid-2 { display: block; }
        body[data-focus] .section { margin: 0; }

        /* ------------------------------------------------------------------
           Responsive
           ------------------------------------------------------------------ */
        @media (max-width: 960px) {
            .summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .headline { grid-column: 1 / -1; grid-row: auto; }
            .grid-2 { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); }
        }

        @media (max-width: 600px) {
            .container { padding: var(--s-5) var(--s-4) var(--s-8); }
            .card { padding: var(--s-4); }
            .headline-value { font-size: 36px; }
            .headline-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-2); }
            .fact-value { font-size: var(--fs-lg); }
            .kpi-value { font-size: var(--fs-xl); }
            .details { grid-template-columns: minmax(0, 1fr); }
            .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .rank-meta-text { min-width: 0; }
        }

        @media print {
            body { background: #fff; }
            .demo-banner, .header-actions, .tabs, .toolbar { display: none !important; }
            .tab-content { display: block !important; }
            .card { break-inside: avoid; box-shadow: none; }
        }
    </style>
</head>

<body>
    <% if (meta.demo) { %>
    <div class="demo-banner" role="note">
        This report was generated from made-up demo data. No real orders, people or venues are shown.
    </div>
    <% } %>

    <div class="container">
        <header class="header">
            <div>
                <p class="eyebrow">Wolt CLI</p>
                <h1>Wolt Expense Report</h1>
                <p class="header-meta" id="header-meta"></p>
            </div>
            <div class="header-actions">
                <label class="currency-field" id="currency-field" hidden>
                    <span>Currency</span>
                    <select id="currency-select" class="control" onchange="onCurrencyChange()"></select>
                </label>
                <button class="control icon-btn" type="button" onclick="toggleTheme()" aria-label="Toggle dark mode" title="Toggle dark mode">
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                </button>
            </div>
        </header>

        <nav class="tabs" role="tablist">
            <button class="tab-btn" role="tab" id="tab-overview" aria-controls="overview" aria-selected="true" onclick="switchTab('overview')">Overview</button>
            <button class="tab-btn" role="tab" id="tab-orders" aria-controls="orders" aria-selected="false" onclick="switchTab('orders')">Orders<span class="tab-count" id="tab-orders-count"></span></button>
        </nav>

        <!-- ============================ OVERVIEW ============================ -->
        <main id="overview" class="tab-content active" role="tabpanel" aria-labelledby="tab-overview">

            <section class="section" data-section="summary" id="summary">
                <div class="summary">
                    <div class="card headline">
                        <div>
                            <p class="stat-label">Lifetime Spending</p>
                            <p class="headline-value num" id="hero-total">&ndash;</p>
                            <p class="headline-sub" id="hero-subtitle"></p>
                        </div>
                        <div class="headline-facts">
                            <div><span class="fact-value num" id="hero-orders">0</span><span class="fact-label">orders</span></div>
                            <div><span class="fact-value num" id="hero-venues">0</span><span class="fact-label">venues</span></div>
                            <div><span class="fact-value num" id="hero-avg">&ndash;</span><span class="fact-label">per order</span></div>
                        </div>
                    </div>
                    <div class="card kpi">
                        <p class="stat-label" id="kpi-ytd-label">This year</p>
                        <p class="kpi-value num" id="kpi-ytd">&ndash;</p>
                        <p class="kpi-sub" id="kpi-ytd-trend"></p>
                    </div>
                    <div class="card kpi">
                        <p class="stat-label">Last 12 months</p>
                        <p class="kpi-value num" id="kpi-12m">&ndash;</p>
                        <p class="kpi-sub" id="kpi-12m-sub"></p>
                    </div>
                    <div class="card kpi">
                        <p class="stat-label">Delivery fees</p>
                        <p class="kpi-value num" id="kpi-delivery">&ndash;</p>
                        <p class="kpi-sub" id="kpi-delivery-pct"></p>
                    </div>
                    <div class="card kpi">
                        <p class="stat-label">Service fees</p>
                        <p class="kpi-value num" id="kpi-service">&ndash;</p>
                        <p class="kpi-sub" id="kpi-service-pct"></p>
                    </div>
                </div>
            </section>

            <section class="section" data-section="monthly" id="monthly">
                <div class="section-head">
                    <h2 class="section-title">Monthly spending</h2>
                    <p class="section-desc">Last 12 months. What you bought, by venue type, with delivery and service fees stacked on top.</p>
                </div>
                <div class="card">
                    <ul class="legend" id="monthly-legend"></ul>
                    <div class="chart-box tall"><canvas id="monthlyTrendChart" role="img" aria-label="Monthly spending, stacked by category"></canvas></div>
                </div>
            </section>

            <div class="grid-2">
                <section class="section" data-section="costs" id="costs">
                    <div class="section-head">
                        <h2 class="section-title">Where the money goes</h2>
                        <p class="section-desc">All-time split between what you ordered and what it cost to get it delivered.</p>
                    </div>
                    <div class="card" id="cost-breakdown"></div>
                </section>

                <section class="section" data-section="weekdays" id="weekdays">
                    <div class="section-head">
                        <h2 class="section-title">Orders by day of week</h2>
                        <p class="section-desc">All-time order count. Your busiest day is highlighted.</p>
                    </div>
                    <div class="card">
                        <div class="chart-box"><canvas id="dayOfWeekChart" role="img" aria-label="Orders by day of week"></canvas></div>
                    </div>
                </section>
            </div>

            <section class="section" data-section="activity" id="activity">
                <div class="section-head">
                    <h2 class="section-title">Order activity</h2>
                    <p class="section-desc">Last 12 months, one square per day, shaded by how much you spent. Click a day to see its orders.</p>
                </div>
                <div class="card">
                    <div class="heatmap-scroll">
                        <div class="heatmap">
                            <div class="heatmap-months" id="heatmap-months"></div>
                            <div class="heatmap-body">
                                <div class="heatmap-days" aria-hidden="true">
                                    <span></span><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span>
                                </div>
                                <div class="heatmap-weeks" id="heatmap-weeks"></div>
                            </div>
                        </div>
                    </div>
                    <div class="heatmap-foot">
                        <div class="heatmap-stats" id="heatmap-stats"></div>
                        <div class="scale" aria-hidden="true">
                            <span>Less</span>
                            <i class="cell"></i><i class="cell" data-level="1"></i><i class="cell" data-level="2"></i><i class="cell" data-level="3"></i><i class="cell" data-level="4"></i>
                            <span>More</span>
                        </div>
                    </div>
                </div>
            </section>

            <div class="grid-2">
                <section class="section" data-section="venues" id="venues">
                    <div class="section-head">
                        <h2 class="section-title">Top venues</h2>
                        <p class="section-desc">Ranked by total spent. Click one to see its orders.</p>
                    </div>
                    <div class="card"><ol class="rank-list" id="venues-list"></ol></div>
                </section>

                <section class="section" data-section="items" id="items">
                    <div class="section-head">
                        <h2 class="section-title">Most ordered items</h2>
                        <p class="section-desc">Ranked by quantity across all orders.</p>
                    </div>
                    <div class="card"><ol class="rank-list" id="items-list"></ol></div>
                </section>
            </div>

            <section class="section" data-section="habits" id="habits">
                <div class="section-head">
                    <h2 class="section-title">Habits</h2>
                    <p class="section-desc">A few patterns hiding in your order history.</p>
                </div>
                <div class="tiles" id="habits-tiles"></div>
                <ul class="places" id="places-list" aria-label="Cities you ordered in"></ul>
            </section>
        </main>

        <!-- ============================= ORDERS ============================= -->
        <div id="orders" class="tab-content" role="tabpanel" aria-labelledby="tab-orders" data-section="orders">
            <div class="toolbar">
                <div class="segmented" role="group" aria-label="Date range">
                    <button type="button" data-preset="all" aria-pressed="true">All time</button>
                    <button type="button" data-preset="this-month" aria-pressed="false">This month</button>
                    <button type="button" data-preset="last-month" aria-pressed="false">Last month</button>
                    <button type="button" data-preset="3-months" aria-pressed="false">3 months</button>
                    <button type="button" data-preset="12-months" aria-pressed="false">12 months</button>
                    <button type="button" data-preset="this-year" aria-pressed="false">This year</button>
                    <button type="button" data-preset="last-year" aria-pressed="false">Last year</button>
                </div>
                <div class="filters">
                    <div class="field grow">
                        <label for="search">Search</label>
                        <input type="search" id="search" class="input" placeholder="Venue, item, city or date (YYYY-MM-DD)">
                    </div>
                    <div class="field">
                        <label for="filter-venue-type">Type</label>
                        <select id="filter-venue-type" class="input"><option value="">All types</option></select>
                    </div>
                    <div class="field" id="filter-currency-field" hidden>
                        <label for="filter-currency">Currency</label>
                        <select id="filter-currency" class="input"><option value="">All</option></select>
                    </div>
                    <div class="field">
                        <label for="filter-date-from">From</label>
                        <input type="date" id="filter-date-from" class="input">
                    </div>
                    <div class="field">
                        <label for="filter-date-to">To</label>
                        <input type="date" id="filter-date-to" class="input">
                    </div>
                    <button class="btn" type="button" onclick="clearFilters()">Clear</button>
                    <button class="btn btn-primary" type="button" onclick="exportFilteredData()">Export CSV</button>
                </div>
            </div>

            <p class="orders-summary" id="orders-summary" aria-live="polite"></p>

            <div class="card table-card">
                <table id="orders-table">
                    <thead>
                        <tr>
                            <th data-sort="date" aria-sort="descending">Date</th>
                            <th data-sort="venue">Venue</th>
                            <th data-sort="type">Type</th>
                            <th>Items</th>
                            <th data-sort="amount" class="right">Amount</th>
                            <th data-sort="status">Status</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <footer class="footer" id="footer"></footer>
    </div>

    <div class="tooltip" id="tooltip" role="tooltip">
        <div class="tooltip-title"></div>
        <div class="tooltip-body"></div>
    </div>

    <script>
        const orders = <%- JSON.stringify(orders).replace(/</g, '\\u003c') %>;
        const REPORT_META = <%- JSON.stringify(meta).replace(/</g, '\\u003c') %>;

        const parseAmount = <%- parseAmountFn %>;
        const getOrderDate = <%- getOrderDateFn %>;
        const processData = <%- processDataFn %>;
        const getOrderCurrency = <%- getOrderCurrencyFn %>;
        const getOrderCity = <%- getOrderCityFn %>;

        // "Now" for every relative calculation. Fixed for demo reports so a
        // published sample never drifts outside its own time window.
        const NOW = REPORT_META.asOf ? new Date(REPORT_META.asOf) : new Date();
        const IGNORED_STATUSES = ['deferred_payment_failed', 'rejected', 'pending_transaction'];
        const params = new URLSearchParams(location.search);

        // ------------------------------------------------------------------
        // Helpers
        // ------------------------------------------------------------------
        function esc(value) {
            return String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        function cssVar(name) {
            return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
        }

        function pad2(n) { return String(n).padStart(2, '0'); }

        // Local calendar date as YYYY-MM-DD (toISOString would shift by timezone)
        function isoDay(d) {
            return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
        }

        function fmtDate(d, opts) {
            return d.toLocaleDateString('en-GB', opts || { day: 'numeric', month: 'short', year: 'numeric' });
        }

        const moneyFormatters = {};
        function formatCurrency(amount, currencyCode, digits) {
            const code = currencyCode || activeCurrency;
            const key = `${code}|${digits}`;
            if (!moneyFormatters[key]) {
                try {
                    moneyFormatters[key] = new Intl.NumberFormat('en-GB', {
                        style: 'currency', currency: code, currencyDisplay: 'narrowSymbol',
                        minimumFractionDigits: digits ?? 2, maximumFractionDigits: digits ?? 2
                    });
                } catch {
                    moneyFormatters[key] = { format: v => `${v.toFixed(digits ?? 2)} ${code}` };
                }
            }
            return moneyFormatters[key].format(amount || 0);
        }

        // Large headline figures drop the cents once they pass 1,000
        function formatMoneyHeadline(amount, code) {
            return formatCurrency(amount, code, Math.abs(amount) >= 1000 ? 0 : 2);
        }

        function formatNumber(num) {
            return Number(num || 0).toLocaleString('en-GB');
        }

        function pct(part, whole) {
            return whole > 0 ? (part / whole) * 100 : 0;
        }

        function humanize(type) {
            const t = String(type || 'Other').replace(/_/g, ' ');
            return t.charAt(0).toUpperCase() + t.slice(1);
        }

        function getOrderItems(order) {
            if (Array.isArray(order.items) && order.items.length > 0) return order.items;
            if (order.details) {
                for (const key of ['order_items', 'items', 'purchases']) {
                    if (Array.isArray(order.details[key]) && order.details[key].length > 0) return order.details[key];
                }
            }
            return [];
        }

        function itemName(i) {
            return (i && (i.name || i.product_name || i.item_name) || '').trim();
        }

        function detailAmount(val) {
            if (typeof val === 'number') return val / 100;
            if (val && typeof val === 'object' && 'amount' in val) return detailAmount(val.amount);
            return parseAmount(val) || 0;
        }

        // ------------------------------------------------------------------
        // Category colours: fixed slot order, assigned by a stable category
        // order so a category keeps its colour for the whole report.
        // ------------------------------------------------------------------
        const TYPE_ORDER = ['restaurant', 'grocery', 'retail', 'pharmacy', 'drugstore', 'alcohol', 'florist', 'electronics', 'home_and_diy'];
        const FEE_KEYS = { 'Delivery': '--fee-1', 'Service Fee': '--fee-2', 'Other Fees': '--fee-3' };
        let typeColorSlots = {};

        function assignTypeColors(types) {
            const sorted = types.filter(t => !FEE_KEYS[t]).sort((a, b) => {
                const ia = TYPE_ORDER.indexOf(a.toLowerCase()), ib = TYPE_ORDER.indexOf(b.toLowerCase());
                return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib) || a.localeCompare(b);
            });
            typeColorSlots = {};
            sorted.forEach((t, i) => { typeColorSlots[t] = i < 7 ? `--series-${i + 1}` : '--fee-3'; });
            return sorted;
        }

        function seriesLabel(t) {
            return { 'Delivery': 'Delivery fees', 'Service Fee': 'Service fees', 'Other Fees': 'Other fees' }[t] || humanize(t);
        }

        function colorFor(type) {
            return cssVar(FEE_KEYS[type] || typeColorSlots[type] || '--fee-3');
        }

        // ------------------------------------------------------------------
        // State
        // ------------------------------------------------------------------
        let activeCurrency = 'EUR';
        let charts = {};
        let currentSort = { column: 'date', direction: 'desc' };
        let currentFilteredData = [];
        const validOrders = orders.filter(o => !IGNORED_STATUSES.includes(o.status));

        function getAllCurrencies() {
            const counts = {};
            validOrders.forEach(o => {
                const cur = getOrderCurrency(o);
                counts[cur] = (counts[cur] || 0) + 1;
            });
            return Object.entries(counts).sort((a, b) => b[1] - a[1]).map(e => e[0]);
        }

        const allCurrencies = getAllCurrencies();

        function initCurrencySelector() {
            const select = document.getElementById('currency-select');
            const field = document.getElementById('currency-field');
            activeCurrency = allCurrencies[0] || 'EUR';
            if (allCurrencies.length <= 1) return;
            field.hidden = false;
            allCurrencies.forEach(cur => {
                const opt = document.createElement('option');
                opt.value = cur;
                opt.textContent = cur;
                select.appendChild(opt);
            });
            const requested = params.get('currency');
            if (requested && allCurrencies.includes(requested)) {
                select.value = requested;
                activeCurrency = requested;
            }
        }

        function onCurrencyChange() {
            activeCurrency = document.getElementById('currency-select').value;
            renderDashboard();
        }

        // ------------------------------------------------------------------
        // Tabs
        // ------------------------------------------------------------------
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.toggle('active', el.id === tabId));
            document.querySelectorAll('.tab-btn').forEach(el => el.setAttribute('aria-selected', String(el.getAttribute('aria-controls') === tabId)));
            reportHeight();
        }

        function showOrdersFor(search) {
            document.getElementById('search').value = search;
            switchTab('orders');
            renderOrders();
            window.scrollTo({ top: 0 });
        }

        // ------------------------------------------------------------------
        // Header
        // ------------------------------------------------------------------
        function renderHeader() {
            const dates = validOrders.map(getOrderDate).sort((a, b) => a - b);
            const meta = document.getElementById('header-meta');
            const asOf = REPORT_META.asOf ? ` as of ${fmtDate(NOW)}` : '';
            meta.textContent = dates.length
                ? `${formatNumber(validOrders.length)} orders from ${fmtDate(dates[0], { month: 'short', year: 'numeric' })} to ${fmtDate(dates[dates.length - 1], { month: 'short', year: 'numeric' })}${asOf}`
                : 'No orders yet';
            document.getElementById('tab-orders-count').textContent = formatNumber(validOrders.length);
            const generated = REPORT_META.generatedAt ? new Date(REPORT_META.generatedAt) : new Date();
            document.getElementById('footer').textContent =
                `Generated ${fmtDate(generated)} by wolt-cli. Unofficial tool, not affiliated with Wolt. All data stays in this file.`;
        }

        // ------------------------------------------------------------------
        // Overview
        // ------------------------------------------------------------------
        function renderSummary(data) {
            const total = data.allTimeTotal;
            document.getElementById('hero-total').textContent = formatMoneyHeadline(total);
            const range = data.firstOrderDate
                ? `${fmtDate(new Date(data.firstOrderDate), { month: 'short', year: 'numeric' })} – ${fmtDate(new Date(data.lastOrderDate), { month: 'short', year: 'numeric' })}`
                : '';
            document.getElementById('hero-subtitle').textContent =
                `Everything paid in ${activeCurrency}${range ? `, ${range}` : ''}`;
            document.getElementById('hero-orders').textContent = formatNumber(data.totalOrderCount);
            document.getElementById('hero-venues').textContent = formatNumber(data.uniqueVenueCount);
            document.getElementById('hero-avg').textContent = formatCurrency(data.avgOrderValue);

            // This year vs the same period last year (not vs all of last year)
            document.getElementById('kpi-ytd-label').textContent = `This year (${NOW.getFullYear()})`;
            document.getElementById('kpi-ytd').textContent = formatMoneyHeadline(data.ytdTotal);
            const trend = document.getElementById('kpi-ytd-trend');
            const cutoff = fmtDate(NOW, { day: 'numeric', month: 'short' });
            if (data.lastYearToDateTotal > 0) {
                const change = pct(data.ytdTotal - data.lastYearToDateTotal, data.lastYearToDateTotal);
                const dir = change >= 0 ? 'up' : 'down';
                const arrow = change >= 0 ? '↑' : '↓';
                trend.innerHTML = Math.abs(change) < 1
                    ? `Same as 1 Jan – ${esc(cutoff)} last year`
                    : `<span class="delta ${dir}">${arrow} ${Math.abs(change).toFixed(0)}%</span> vs 1 Jan – ${esc(cutoff)} ${NOW.getFullYear() - 1}`;
            } else {
                trend.textContent = `${formatNumber(data.ytdOrderCount)} orders so far`;
            }

            document.getElementById('kpi-12m').textContent = formatMoneyHeadline(data.last12MonthsTotal);
            document.getElementById('kpi-12m-sub').textContent =
                `≈ ${formatCurrency(data.last12MonthsTotal / 12, null, 0)} a month · ${formatNumber(data.last12MonthsOrderCount)} orders`;

            document.getElementById('kpi-delivery').textContent = formatMoneyHeadline(data.totalDeliveryFees);
            document.getElementById('kpi-delivery-pct').textContent =
                `${pct(data.totalDeliveryFees, total).toFixed(1)}% of spending · ${formatCurrency(data.totalDeliveryFees / Math.max(data.totalOrderCount, 1))} per order`;
            document.getElementById('kpi-service').textContent = formatMoneyHeadline(data.totalServiceFees);
            document.getElementById('kpi-service-pct').textContent =
                `${pct(data.totalServiceFees, total).toFixed(1)}% of spending · ${formatCurrency(data.totalServiceFees / Math.max(data.totalOrderCount, 1))} per order`;
        }

        function renderMonthlyChart(data) {
            const box = document.getElementById('monthlyTrendChart').parentElement;
            const legend = document.getElementById('monthly-legend');
            const types = data.stackedTypes.filter(t => !FEE_KEYS[t]);
            const orderedTypes = assignTypeColors(types);
            const fees = ['Delivery', 'Service Fee', 'Other Fees'].filter(t => data.stackedTypes.includes(t));
            const series = [...orderedTypes, ...fees];

            legend.innerHTML = series.map(t =>
                `<li><span class="swatch" style="background:${colorFor(t)}"></span>${esc(seriesLabel(t))}</li>`
            ).join('');

            if (typeof Chart === 'undefined') {
                box.innerHTML = '<div class="chart-fallback">Charts need an internet connection the first time the report is opened.</div>';
                return;
            }

            const surface = cssVar('--surface');
            charts.monthly = new Chart(document.getElementById('monthlyTrendChart'), {
                type: 'bar',
                data: {
                    labels: data.monthly.map(m => m.label),
                    datasets: series.map(t => ({
                        label: seriesLabel(t),
                        data: data.monthly.map(m => m.byType[t] || 0),
                        backgroundColor: colorFor(t),
                        borderColor: surface,
                        borderWidth: { top: 2, bottom: 0, left: 0, right: 0 },
                        borderSkipped: false,
                        borderRadius: 3,
                        maxBarThickness: 36
                    }))
                },
                options: chartOptions({
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            ...tooltipStyle(),
                            mode: 'index',
                            filter: item => item.raw > 0,
                            callbacks: {
                                label: ctx => ` ${ctx.dataset.label}: ${formatCurrency(ctx.raw)}`,
                                footer: items => `Total: ${formatCurrency(items.reduce((s, i) => s + i.raw, 0))}`
                            }
                        }
                    },
                    scales: {
                        x: { stacked: true, grid: { display: false }, border: { color: cssVar('--axis') } },
                        y: {
                            stacked: true,
                            beginAtZero: true,
                            border: { display: false },
                            grid: { color: cssVar('--grid') },
