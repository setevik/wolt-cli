        function renderCostBreakdown(data) {
            const el = document.getElementById('cost-breakdown');
            const total = data.allTimeTotal;
            const items = data.costBreakdown.items;
            const delivery = data.costBreakdown.delivery;
            const service = data.costBreakdown.service;
            const other = Math.max(0, total - items - delivery - service);
            const parts = [
                { label: 'Food & goods', value: items, color: 'var(--series-1)' },
                { label: 'Delivery fees', value: delivery, color: 'var(--fee-1)' },
                { label: 'Service fees', value: service, color: 'var(--fee-2)' }
            ];
            if (other > total * 0.005) parts.push({ label: 'Other (tips, adjustments)', value: other, color: 'var(--fee-3)' });

            if (total <= 0) {
                el.innerHTML = '<div class="empty-state">No spending recorded yet.</div>';
                return;
            }

            const feeTotal = delivery + service;
            const feePerOrder = feeTotal / Math.max(data.totalOrderCount, 1);
            el.innerHTML = `
                <p class="stat-label">Total ${esc(formatMoneyHeadline(total))}</p>
                <div class="split-bar" role="img" aria-label="${esc(parts.map(p => `${p.label} ${pct(p.value, total).toFixed(0)}%`).join(', '))}">
                    ${parts.filter(p => p.value > 0).map(p => `<span style="flex:${p.value};background:${p.color}" title="${esc(p.label)}"></span>`).join('')}
                </div>
                <ul class="rows">
                    ${parts.map(p => `
                        <li class="row">
                            <span class="swatch" style="background:${p.color}"></span>
                            <span class="row-label">${esc(p.label)}</span>
                            <span class="row-value num">${esc(formatCurrency(p.value))}</span>
                            <span class="row-pct num">${pct(p.value, total).toFixed(1)}%</span>
                        </li>`).join('')}
                </ul>
                <p class="callout">Fees added <strong>${esc(formatCurrency(feePerOrder))}</strong> to the average order, or
                    <strong>${pct(feeTotal, items).toFixed(0)}%</strong> on top of the price of the food itself.</p>`;
        }

        function renderWeekdayChart(data) {
            const box = document.getElementById('dayOfWeekChart').parentElement;
            if (typeof Chart === 'undefined') {
                box.innerHTML = '<div class="chart-fallback">Charts need an internet connection the first time the report is opened.</div>';
                return;
            }
            // Monday first
            const days = [...data.dayOfWeekBreakdown.slice(1), data.dayOfWeekBreakdown[0]];
            const max = Math.max(...days.map(d => d.orders));
            const accent = cssVar('--accent');
            const rest = cssVar('--seq-1');
            charts.weekday = new Chart(document.getElementById('dayOfWeekChart'), {
                type: 'bar',
                data: {
                    labels: days.map(d => d.day),
                    datasets: [{
                        label: 'Orders',
                        data: days.map(d => d.orders),
                        backgroundColor: days.map(d => d.orders === max && max > 0 ? accent : rest),
                        borderRadius: { topLeft: 4, topRight: 4 },
                        borderSkipped: 'start',
                        maxBarThickness: 28
                    }]
                },
                options: chartOptions({
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            ...tooltipStyle(),
                            callbacks: {
                                label: ctx => ` ${ctx.raw} orders · ${formatCurrency(days[ctx.dataIndex].spent)}`
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, border: { color: cssVar('--axis') } },
                        y: { beginAtZero: true, border: { display: false }, grid: { color: cssVar('--grid') }, ticks: { precision: 0, maxTicksLimit: 5 } }
                    }
                })
            });
        }

        function chartOptions(extra) {
            return {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 300 },
                interaction: { mode: 'index', intersect: false },
                ...extra
            };
        }

        function tooltipStyle() {
            return {
                backgroundColor: cssVar('--surface'),
                titleColor: cssVar('--ink'),
                bodyColor: cssVar('--ink-2'),
                footerColor: cssVar('--ink'),
                borderColor: cssVar('--line'),
                borderWidth: 1,
                padding: 10,
                boxPadding: 4,
                usePointStyle: true,
                cornerRadius: 6
            };
        }

        // Heatmap: shading uses quartiles of active days, so one big grocery
        // run doesn't wash out every other day.
        function renderHeatmap(dailyActivity) {
            const weeksEl = document.getElementById('heatmap-weeks');
            const monthsEl = document.getElementById('heatmap-months');
            const statsEl = document.getElementById('heatmap-stats');
            weeksEl.innerHTML = '';
            monthsEl.innerHTML = '';

            const today = new Date(NOW.getFullYear(), NOW.getMonth(), NOW.getDate());
            const start = new Date(today);
            start.setDate(start.getDate() - 364);
            start.setDate(start.getDate() - start.getDay());

            const totals = Object.values(dailyActivity).map(d => d.total).filter(v => v > 0).sort((a, b) => a - b);
            const q = p => totals.length ? totals[Math.min(totals.length - 1, Math.floor(p * totals.length))] : 0;
            const cuts = [q(0.25), q(0.5), q(0.75)];
            const level = v => v <= 0 ? 0 : v <= cuts[0] ? 1 : v <= cuts[1] ? 2 : v <= cuts[2] ? 3 : 4;

            const cursor = new Date(start);
            let week = 0;
            while (cursor <= today) {
                const col = document.createElement('div');
                col.className = 'heatmap-week';
                for (let d = 0; d < 7; d++) {
                    const cell = document.createElement('i');
                    cell.className = 'cell';
                    if (cursor > today) {
                        cell.classList.add('empty');
                    } else {
                        if (cursor.getDate() === 1) {
                            const label = document.createElement('span');
                            label.textContent = cursor.toLocaleString('en-GB', { month: 'short' });
                            label.style.left = `${week * 15}px`;
                            monthsEl.appendChild(label);
                        }
                        const key = isoDay(cursor);
                        const act = dailyActivity[key];
                        const lvl = act ? level(act.total) : 0;
                        if (lvl) cell.dataset.level = lvl;
                        cell.dataset.date = key;
                        cell.tabIndex = -1;
                        cell.addEventListener('mouseenter', e => {
                            const date = new Date(key + 'T00:00:00');
                            const body = act
                                ? `${act.orderCount} order${act.orderCount > 1 ? 's' : ''} · ${formatCurrency(act.total)}<br>${esc(act.venues.join(', '))}`
                                : 'No orders';
                            showTooltip(e.target, fmtDate(date, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }), body);
                        });
                        cell.addEventListener('mouseleave', hideTooltip);
                        cell.addEventListener('click', () => { hideTooltip(); showOrdersFor(key); });
                    }
                    col.appendChild(cell);
                    cursor.setDate(cursor.getDate() + 1);
                }
                weeksEl.appendChild(col);
                week++;
            }
            const days = Object.values(dailyActivity);
            const totalOrders = days.reduce((s, d) => s + d.orderCount, 0);
            const totalSpent = days.reduce((s, d) => s + d.total, 0);
            statsEl.innerHTML = `
                <span><strong>${formatNumber(totalOrders)}</strong> orders</span>
                <span><strong>${formatNumber(days.length)}</strong> active days</span>
                <span><strong>${calculateStreak(dailyActivity, start, today)}</strong> day longest streak</span>
                <span><strong>${esc(formatCurrency(totalSpent, null, 0))}</strong> spent</span>`;

            // Show the most recent weeks first on narrow screens
            const scroller = weeksEl.closest('.heatmap-scroll');
            scroller.scrollLeft = scroller.scrollWidth;
        }

        function calculateStreak(dailyActivity, startDate, endDate) {
            let best = 0, run = 0;
            const d = new Date(startDate);
            while (d <= endDate) {
                run = dailyActivity[isoDay(d)] ? run + 1 : 0;
                best = Math.max(best, run);
                d.setDate(d.getDate() + 1);
            }
            return best;
        }

        function showTooltip(target, title, bodyHtml) {
            const tip = document.getElementById('tooltip');
            tip.querySelector('.tooltip-title').textContent = title;
            tip.querySelector('.tooltip-body').innerHTML = bodyHtml;
            tip.classList.add('visible');
            const r = target.getBoundingClientRect();
            const left = Math.min(Math.max(8, r.left + r.width / 2 - tip.offsetWidth / 2), window.innerWidth - tip.offsetWidth - 8);
            const top = r.top - tip.offsetHeight - 8;
            tip.style.left = `${left}px`;
            tip.style.top = `${top < 8 ? r.bottom + 8 : top}px`;
        }

        function hideTooltip() {
            document.getElementById('tooltip').classList.remove('visible');
        }

        function renderTopVenues(topVenues) {
            const list = document.getElementById('venues-list');
            if (!topVenues.length) {
                list.innerHTML = '<li class="empty-state">No venues yet.</li>';
                return;
            }
            const max = topVenues[0].total;
            list.innerHTML = '';
            topVenues.slice(0, 8).forEach((v, i) => {
                const li = document.createElement('li');
                li.innerHTML = `
                    <button type="button" class="rank-item">
                        <span class="rank-pos num">${i + 1}</span>
                        <span class="rank-name">${esc(v.name)}</span>
                        <span class="rank-value num">${esc(formatCurrency(v.total, v.currency))}</span>
                        <span class="rank-meta">
                            <span class="rank-bar"><span style="width:${pct(v.total, max).toFixed(1)}%"></span></span>
                            <span class="rank-meta-text">${v.orderCount} orders · ${esc(humanize(v.type))}</span>
                        </span>
                    </button>`;
                li.querySelector('button').addEventListener('click', () => showOrdersFor(v.name));
                list.appendChild(li);
            });
        }

        function renderTopItems(topItems) {
            const list = document.getElementById('items-list');
            if (!topItems.length) {
                list.innerHTML = '<li class="empty-state">No item details available. Run <code>wolt-cli sync</code> to fetch them.</li>';
                return;
            }
            const max = topItems[0].count;
            list.innerHTML = topItems.slice(0, 8).map((item, i) => `
                <li class="rank-item">
                    <span class="rank-pos num">${i + 1}</span>
                    <span class="rank-name" title="${esc(item.name)}">${esc(item.name)}</span>
                    <span class="rank-value num">×${item.count}</span>
                    <span class="rank-meta">
                        <span class="rank-bar"><span style="width:${pct(item.count, max).toFixed(1)}%"></span></span>
                    </span>
                </li>`).join('');
        }

        function renderHabits(data, cities) {
            const container = document.getElementById('habits-tiles');
            const weeks = data.firstOrderDate ? Math.max(1, (NOW - data.firstOrderDate) / (7 * 24 * 3600 * 1000)) : 1;
            const tiles = [
                { label: 'Busiest day', value: data.favoriteDay.orderCount ? data.favoriteDay.name : '–', detail: `${formatNumber(data.favoriteDay.orderCount)} orders all-time` },
                { label: 'Orders per week', value: (data.totalOrderCount / weeks).toFixed(1), detail: 'on average, since your first order' },
                { label: 'Biggest order', value: formatCurrency(data.biggestOrder.amount, data.biggestOrder.currency), detail: data.biggestOrder.venue ? `${data.biggestOrder.venue}, ${fmtDate(new Date(data.biggestOrder.date + 'T00:00:00'))}` : '' },
                { label: 'Late-night orders', value: formatNumber(data.lateNightOrders), detail: `${pct(data.lateNightOrders, data.totalOrderCount).toFixed(0)}% placed after 10 pm` },
                { label: 'Items ordered', value: formatNumber(data.totalItemsCount), detail: `≈ ${(data.totalItemsCount / Math.max(data.totalOrderCount, 1)).toFixed(1)} per order` },
                { label: `Delivery distance (${NOW.getFullYear()})`, value: `${formatNumber(Math.round(data.ytdDistance / 1000))} km`, detail: 'travelled by couriers this year' }
            ];
            container.innerHTML = tiles.map(t => `
                <div class="card tile">
                    <p class="stat-label">${esc(t.label)}</p>
                    <p class="tile-value num">${esc(t.value)}</p>
                    <p class="tile-detail">${esc(t.detail)}</p>
                </div>`).join('');

            const places = document.getElementById('places-list');
            places.innerHTML = cities.length > 1
                ? `<li class="places-label">Ordered in ${cities.length} cities</li>` + cities.map(c => `<li class="chip">${esc(c.country ? `${c.city}, ${c.country}` : c.city)} <span class="muted num">${formatNumber(c.orderCount)}</span></li>`).join('')
                : '';
        }

        function renderDashboard() {
            try {
                Object.values(charts).forEach(c => c && c.destroy());
                charts = {};

                const currencyOrders = orders.filter(o => getOrderCurrency(o) === activeCurrency);
                const data = processData(currencyOrders, NOW);
                // Cities aren't money, so count them across every currency
                const cities = processData(orders, NOW).citiesWithOrders;

                renderSummary(data);
                renderMonthlyChart(data);
                renderCostBreakdown(data);
                renderWeekdayChart(data);
                renderHeatmap(data.dailyActivity);
                renderTopVenues(data.topVenues);
                renderTopItems(data.topItems);
                renderHabits(data, cities);
                reportHeight();
            } catch (error) {
                console.error('Error rendering dashboard:', error);
            }
        }

        // ------------------------------------------------------------------
        // Orders
        // ------------------------------------------------------------------
        const ordersIndex = orders.map(order => {
            const dateObj = getOrderDate(order);
            const items = getOrderItems(order);
            const details = order.details || {};
            const { city } = getOrderCity(order);
            return {
                order,
                date: isNaN(dateObj.getTime()) ? 'N/A' : isoDay(dateObj),
                time: typeof order.received_at === 'string' && order.received_at.includes(',') ? order.received_at.split(',')[1].trim() : '',
                dateObj,
                venue: order.venue_name || 'Unknown',
                type: details.venue_product_line || 'Other',
                items,
                itemsDisplay: items.map(itemName).filter(Boolean).join(', '),
                // The detail endpoint carries prices; the list endpoint doesn't
                detailItems: Array.isArray(details.order_items) && details.order_items.length ? details.order_items : items,
                amount: parseAmount(order.total_amount || '0'),
                status: order.status || '',
                ignored: IGNORED_STATUSES.includes(order.status),
                itemsPrice: detailAmount(details.items_price),
                deliveryPrice: detailAmount(details.delivery_base_price),
                serviceFee: detailAmount(details.service_fee),
                distance: parseAmount(details.delivery_distance) || 0,
                currency: getOrderCurrency(order),
                city: city || ''
            };
        });

        function populateFilters() {
            const types = [...new Set(ordersIndex.map(o => o.type))].sort();
            const select = document.getElementById('filter-venue-type');
            types.forEach(t => select.add(new Option(humanize(t), t)));
            if (allCurrencies.length > 1) {
                document.getElementById('filter-currency-field').hidden = false;
                const cur = document.getElementById('filter-currency');
                allCurrencies.forEach(c => cur.add(new Option(c, c)));
            }
        }

        function renderOrders() {
            const tbody = document.querySelector('#orders-table tbody');
            const search = document.getElementById('search').value.trim().toLowerCase();
            const type = document.getElementById('filter-venue-type').value;
            const currency = document.getElementById('filter-currency').value;
            const from = document.getElementById('filter-date-from').value;
            const to = document.getElementById('filter-date-to').value;

            const rows = ordersIndex.filter(o => {
                if (o.ignored) return false;
                if (search && !(o.venue.toLowerCase().includes(search) || o.itemsDisplay.toLowerCase().includes(search) ||
                    o.date.includes(search) || o.city.toLowerCase().includes(search))) return false;
                if (type && o.type !== type) return false;
                if (currency && o.currency !== currency) return false;
                if (from && o.date < from) return false;
                if (to && o.date > to) return false;
                return true;
            });

            const dir = currentSort.direction === 'asc' ? 1 : -1;
            const keyOf = {
                date: o => o.dateObj.getTime() + (o.time ? parseInt(o.time.replace(':', ''), 10) : 0),
                venue: o => o.venue.toLowerCase(),
                type: o => o.type.toLowerCase(),
                amount: o => o.amount,
                status: o => o.status
            }[currentSort.column];
            rows.sort((a, b) => {
                const x = keyOf(a), y = keyOf(b);
                return (x < y ? -1 : x > y ? 1 : 0) * dir;
            });
            currentFilteredData = rows;

            const fragment = document.createDocumentFragment();
            const limit = 500;
            rows.slice(0, limit).forEach(o => {
                const tr = document.createElement('tr');
                tr.className = 'order-row';
                tr.tabIndex = 0;
                tr.setAttribute('aria-expanded', 'false');
                tr.innerHTML = `
                    <td class="num"><span class="chevron" aria-hidden="true">›</span>${esc(o.date)}</td>
                    <td>${esc(o.venue)}</td>
                    <td>${esc(humanize(o.type))}</td>
                    <td class="cell-items" title="${esc(o.itemsDisplay)}">${esc(o.itemsDisplay)}</td>
                    <td class="right num">${esc(formatCurrency(o.amount, o.currency))}</td>
                    <td><span class="pill">${esc(humanize(o.status))}</span></td>`;

                const detailsTr = document.createElement('tr');
                detailsTr.className = 'details-row';
                const other = o.amount - o.itemsPrice - o.deliveryPrice - o.serviceFee;
                const itemRows = o.detailItems.filter(itemName).map(i => {
                    const count = i.count || i.quantity || 1;
                    const price = typeof i.base_price === 'number' ? formatCurrency(i.base_price * count / 100, o.currency) : '';
                    return `<dt>${count > 1 ? `${count} × ` : ''}${esc(itemName(i))}</dt><dd class="num">${esc(price)}</dd>`;
                }).join('');
                detailsTr.innerHTML = `
                    <td colspan="6">
                        <div class="details">
                            <div>
                                <h4>Items</h4>
                                ${itemRows ? `<dl>${itemRows}</dl>` : '<span class="muted">No item details</span>'}
                            </div>
                            <div>
                                <h4>Cost breakdown</h4>
                                <dl>
                                    <dt>Items</dt><dd class="num">${esc(formatCurrency(o.itemsPrice, o.currency))}</dd>
                                    <dt>Delivery fee</dt><dd class="num">${esc(formatCurrency(o.deliveryPrice, o.currency))}</dd>
                                    <dt>Service fee</dt><dd class="num">${esc(formatCurrency(o.serviceFee, o.currency))}</dd>
                                    ${Math.abs(other) > 0.009 && o.itemsPrice ? `<dt>Other</dt><dd class="num">${esc(formatCurrency(other, o.currency))}</dd>` : ''}
                                    <dt class="total">Total</dt><dd class="total num">${esc(formatCurrency(o.amount, o.currency))}</dd>
                                    ${o.distance ? `<dt>Distance</dt><dd class="num">${(o.distance / 1000).toFixed(1)} km</dd>` : ''}
                                    ${o.city ? `<dt>City</dt><dd>${esc(o.city)}</dd>` : ''}
                                    ${o.time ? `<dt>Time</dt><dd class="num">${esc(o.time)}</dd>` : ''}
                                </dl>
                            </div>
                        </div>
                    </td>`;

                const toggle = () => {
                    const open = detailsTr.classList.toggle('open');
                    tr.setAttribute('aria-expanded', String(open));
                    reportHeight();
                };
                tr.addEventListener('click', toggle);
                tr.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
                fragment.appendChild(tr);
                fragment.appendChild(detailsTr);
            });
            tbody.innerHTML = '';
            if (!rows.length) {
                tbody.innerHTML = '<tr><td colspan="6" class="empty-state">No orders match these filters.</td></tr>';
            }
            tbody.appendChild(fragment);

            // Totals per currency: never add euros to crowns
            const totals = {};
            rows.forEach(o => { totals[o.currency] = (totals[o.currency] || 0) + o.amount; });
            const totalText = Object.entries(totals).sort((a, b) => b[1] - a[1])
                .map(([cur, sum]) => `<strong>${esc(formatCurrency(sum, cur))}</strong>`).join(' + ');
            document.getElementById('orders-summary').innerHTML =
                `<strong>${formatNumber(rows.length)}</strong> orders${totalText ? ` · ${totalText}` : ''}` +
                (rows.length > limit ? ` · showing the first ${limit}, narrow the filters to see more` : '');
            reportHeight();
        }

        function setPreset(preset) {
            const t = NOW;
            let from = null, to = null;
            switch (preset) {
                case 'this-month': from = new Date(t.getFullYear(), t.getMonth(), 1); to = t; break;
                case 'last-month': from = new Date(t.getFullYear(), t.getMonth() - 1, 1); to = new Date(t.getFullYear(), t.getMonth(), 0); break;
                case '3-months': from = new Date(t.getFullYear(), t.getMonth() - 2, 1); to = t; break;
                case '12-months': from = new Date(t.getFullYear(), t.getMonth() - 11, 1); to = t; break;
                case 'this-year': from = new Date(t.getFullYear(), 0, 1); to = t; break;
                case 'last-year': from = new Date(t.getFullYear() - 1, 0, 1); to = new Date(t.getFullYear() - 1, 11, 31); break;
            }
            document.getElementById('filter-date-from').value = from ? isoDay(from) : '';
            document.getElementById('filter-date-to').value = to ? isoDay(to) : '';
            markPreset(preset);
            renderOrders();
        }

        function markPreset(preset) {
            document.querySelectorAll('[data-preset]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.preset === preset)));
        }

        function clearFilters() {
            ['search', 'filter-venue-type', 'filter-currency', 'filter-date-from', 'filter-date-to'].forEach(id => { document.getElementById(id).value = ''; });
            markPreset('all');
            renderOrders();
        }

        function handleSort(column) {
            currentSort = currentSort.column === column
                ? { column, direction: currentSort.direction === 'asc' ? 'desc' : 'asc' }
                : { column, direction: column === 'venue' || column === 'type' || column === 'status' ? 'asc' : 'desc' };
            document.querySelectorAll('th[data-sort]').forEach(th => {
                if (th.dataset.sort === currentSort.column) th.setAttribute('aria-sort', currentSort.direction === 'asc' ? 'ascending' : 'descending');
                else th.removeAttribute('aria-sort');
            });
            renderOrders();
        }

        function exportFilteredData() {
            if (!currentFilteredData.length) {
                alert('No orders to export');
                return;
            }
            const cell = s => /[",\n]/.test(String(s)) ? `"${String(s).replace(/"/g, '""')}"` : String(s);
            const lines = ['Date,Venue,Type,Items,Amount,Currency,Delivery Fee,Service Fee,City,Status'];
            currentFilteredData.forEach(o => {
                lines.push([o.date, o.venue, o.type, o.itemsDisplay, o.amount.toFixed(2), o.currency,
                    o.deliveryPrice.toFixed(2), o.serviceFee.toFixed(2), o.city, o.status].map(cell).join(','));
            });
            const blob = new Blob([lines.join('\n') + '\n'], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `wolt-orders-${isoDay(new Date())}.csv`;
            link.click();
        }

        // ------------------------------------------------------------------
        // Theme & embedding
        // ------------------------------------------------------------------
        function applyTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            if (typeof Chart !== 'undefined') {
                Chart.defaults.color = cssVar('--ink-3');
                Chart.defaults.borderColor = cssVar('--grid');
                Chart.defaults.font.family = cssVar('--font');
            }
        }

        function toggleTheme() {
            const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            try { localStorage.setItem('wolt-report-theme', next); } catch {}
            applyTheme(next);
            renderDashboard();
        }

        function initialTheme() {
            const fromUrl = params.get('theme');
            if (fromUrl === 'dark' || fromUrl === 'light') return fromUrl;
            try {
                const saved = localStorage.getItem('wolt-report-theme');
                if (saved === 'dark' || saved === 'light') return saved;
            } catch {}
            return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        // When embedded in the project site, tell the parent page how tall we are
        function reportHeight() {
            if (window.parent === window) return;
            requestAnimationFrame(() => {
                window.parent.postMessage({ type: 'wolt-report-height', height: document.documentElement.scrollHeight }, '*');
            });
        }

        function initEmbed() {
            if (!params.has('embed')) return;
            document.body.classList.add('embed');
            const focus = params.get('section');
            if (focus) {
                document.body.dataset.focus = focus;
                const style = document.createElement('style');
                style.textContent = `body[data-focus="${CSS.escape(focus)}"] [data-section="${CSS.escape(focus)}"] { display: block; }`;
                document.head.appendChild(style);
                if (focus === 'orders') switchTab('orders');
            }
            window.addEventListener('message', e => {
                if (e.data && e.data.type === 'wolt-report-theme') {
                    applyTheme(e.data.theme === 'dark' ? 'dark' : 'light');
                    renderDashboard();
                }
            });
            window.addEventListener('resize', reportHeight);
        }

        // ------------------------------------------------------------------
        // Wire up
        // ------------------------------------------------------------------
        document.getElementById('search').addEventListener('input', () => { renderOrders(); });
        document.getElementById('filter-venue-type').addEventListener('change', renderOrders);
        document.getElementById('filter-currency').addEventListener('change', renderOrders);
        ['filter-date-from', 'filter-date-to'].forEach(id => document.getElementById(id).addEventListener('change', () => { markPreset(null); renderOrders(); }));
        document.querySelectorAll('[data-preset]').forEach(b => b.addEventListener('click', () => setPreset(b.dataset.preset)));
        document.querySelectorAll('th[data-sort]').forEach(th => th.addEventListener('click', () => handleSort(th.dataset.sort)));

        applyTheme(initialTheme());
        initEmbed();
        initCurrencySelector();
        populateFilters();
        renderHeader();
        renderDashboard();
        renderOrders();
        if (!params.has('embed') && location.hash === '#orders') switchTab('orders');
    </script>
</body>

</html>
