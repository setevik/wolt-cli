<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wolt Expense Report</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* CSS Variables for theming */
        :root {
            --bg-primary: #f8fafc;
            --bg-secondary: #ffffff;
            --bg-card: #ffffff;
            --bg-hover: #f1f5f9;
            --bg-accent: linear-gradient(135deg, #009de0 0%, #0077b6 100%);
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --text-muted: #94a3b8;
            --text-inverse: #ffffff;
            --border-color: #e2e8f0;
            --border-dark: #cbd5e1;
            --accent-color: #009de0;
            --accent-light: #e0f2fe;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --chart-bg: #ffffff;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
            --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
            --radius-sm: 6px;
            --radius-md: 12px;
            --radius-lg: 16px;
        }

        [data-theme="dark"] {
            --bg-primary: #0f172a;
            --bg-secondary: #1e293b;
            --bg-card: #1e293b;
            --bg-hover: #334155;
            --bg-accent: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
            --text-primary: #f1f5f9;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --text-inverse: #ffffff;
            --border-color: #334155;
            --border-dark: #475569;
            --accent-color: #38bdf8;
            --accent-light: #0c4a6e;
            --chart-bg: #1e293b;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
            --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.4);
            --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.5);
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: var(--bg-primary);
            color: var(--text-primary);
            transition: background 0.3s, color 0.3s;
            line-height: 1.5;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 24px;
        }

        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .header-actions {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .theme-toggle {
            padding: 10px 16px;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            background: var(--bg-card);
            color: var(--text-primary);
            cursor: pointer;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }

        .theme-toggle:hover {
            background: var(--bg-hover);
            border-color: var(--border-dark);
        }

        /* Tabs */
        .tabs {
            display: flex;
            gap: 4px;
            margin-bottom: 24px;
            background: var(--bg-card);
            padding: 4px;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            width: fit-content;
        }

        .tab-btn {
            padding: 12px 24px;
            border: none;
            background: transparent;
            font-size: 15px;
            cursor: pointer;
            color: var(--text-secondary);
            font-weight: 500;
            border-radius: var(--radius-sm);
            transition: all 0.2s;
        }

        .tab-btn:hover {
            color: var(--text-primary);
            background: var(--bg-hover);
        }

        .tab-btn.active {
            color: var(--text-inverse);
            background: var(--accent-color);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Hero Banner */
        .hero-banner {
            background: var(--bg-accent);
            border-radius: var(--radius-lg);
            padding: 32px 40px;
            margin-bottom: 32px;
            color: var(--text-inverse);
            box-shadow: var(--shadow-lg);
        }

        .hero-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 24px;
        }

        .hero-main {
            flex: 1;
            min-width: 280px;
        }

        .hero-label {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .hero-value {
            font-size: 48px;
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 8px;
        }

        .hero-subtitle {
            font-size: 16px;
            opacity: 0.85;
        }

        .hero-stats {
            display: flex;
            gap: 40px;
            flex-wrap: wrap;
        }

        .hero-stat {
            text-align: center;
        }

        .hero-stat-value {
            font-size: 32px;
            font-weight: 700;
            display: block;
        }

        .hero-stat-label {
            font-size: 13px;
            opacity: 0.85;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        /* Section Layout */
        .section {
            margin-bottom: 32px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 20px;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-title-icon {
            font-size: 24px;
        }

        /* Card Styles */
        .card {
            background: var(--bg-card);
            border-radius: var(--radius-md);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            transition: box-shadow 0.2s, transform 0.2s;
        }

        .card:hover {
            box-shadow: var(--shadow-md);
        }

        .card-body {
            padding: 20px;
        }

        /* KPI Grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 32px;
        }

        .kpi-card {
            background: var(--bg-card);
            border-radius: var(--radius-md);
            padding: 20px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
        }

        .kpi-label {
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .kpi-value {
            font-size: 28px;
            font-weight: 700;
            color: var(--accent-color);
            line-height: 1.2;
        }

        .kpi-subtitle {
            font-size: 13px;
            color: var(--text-secondary);
            margin-top: 6px;
        }

        .kpi-trend {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 13px;
            margin-top: 8px;
            padding: 4px 8px;
            border-radius: 4px;
        }

        .kpi-trend.up {
            background: #fef2f2;
            color: #dc2626;
        }

        .kpi-trend.down {
            background: #f0fdf4;
            color: #16a34a;
        }

        [data-theme="dark"] .kpi-trend.up {
            background: rgba(239, 68, 68, 0.2);
        }

        [data-theme="dark"] .kpi-trend.down {
            background: rgba(34, 197, 94, 0.2);
        }

        /* Charts Grid */
        .charts-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
            margin-bottom: 32px;
        }

        .charts-grid.single {
            grid-template-columns: 1fr;
        }

        @media (max-width: 900px) {
            .charts-grid {
                grid-template-columns: 1fr;
            }
        }

        .chart-card {
            background: var(--bg-card);
            border-radius: var(--radius-md);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            padding: 24px;
        }

        .chart-card.full-width {
            grid-column: 1 / -1;
        }

        .chart-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0 0 16px 0;
        }

        .chart-container {
            height: 280px;
            position: relative;
        }

        .chart-container.tall {
            height: 350px;
        }

        /* Activity Heatmap */
        .heatmap-card {
            background: var(--bg-card);
            border-radius: var(--radius-md);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            padding: 24px;
            margin-bottom: 32px;
        }

        .heatmap-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }

        .heatmap-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
        }

        .heatmap-container {
            overflow-x: auto;
            padding-bottom: 8px;
        }

        .heatmap-wrapper {
            display: inline-block;
            min-width: fit-content;
        }

        .heatmap-months {
            display: flex;
            margin-left: 32px;
            margin-bottom: 8px;
            font-size: 12px;
            color: var(--text-muted);
        }

        .heatmap-month {
            flex: 1;
            text-align: left;
        }

        .heatmap-grid {
            display: flex;
        }

        .heatmap-days-labels {
            display: flex;
            flex-direction: column;
            margin-right: 6px;
            font-size: 11px;
            color: var(--text-muted);
        }

        .heatmap-day-label {
            height: 13px;
            line-height: 13px;
        }

        .heatmap-weeks {
            display: flex;
            gap: 3px;
        }

        .heatmap-week {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .heatmap-day {
            width: 12px;
            height: 12px;
            border-radius: 3px;
            background: var(--border-color);
            cursor: pointer;
            transition: transform 0.1s;
        }

        .heatmap-day:hover {
            transform: scale(1.3);
        }

        .heatmap-day.level-1 { background: #9be9a8; }
        .heatmap-day.level-2 { background: #40c463; }
        .heatmap-day.level-3 { background: #30a14e; }
        .heatmap-day.level-4 { background: #216e39; }

        [data-theme="dark"] .heatmap-day.level-1 { background: #0e4429; }
        [data-theme="dark"] .heatmap-day.level-2 { background: #006d32; }
        [data-theme="dark"] .heatmap-day.level-3 { background: #26a641; }
        [data-theme="dark"] .heatmap-day.level-4 { background: #39d353; }

        .heatmap-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid var(--border-color);
            flex-wrap: wrap;
            gap: 16px;
        }

        .heatmap-stats {
            display: flex;
            gap: 24px;
            font-size: 14px;
            color: var(--text-secondary);
        }

        .heatmap-stats strong {
            color: var(--text-primary);
        }

        .heatmap-legend {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: var(--text-muted);
        }

        .heatmap-legend-item {
            width: 12px;
            height: 12px;
            border-radius: 3px;
        }

        /* Heatmap Tooltip */
        .heatmap-tooltip {
            position: fixed;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            font-size: 13px;
            pointer-events: none;
            z-index: 1000;
            max-width: 300px;
            box-shadow: var(--shadow-lg);
            display: none;
        }

        .heatmap-tooltip.visible {
            display: block;
        }

        .tooltip-date {
            font-weight: 600;
            margin-bottom: 6px;
            color: var(--accent-color);
        }

        .tooltip-stats {
            margin-bottom: 6px;
        }

        .tooltip-venues {
            font-size: 12px;
            color: var(--text-muted);
            border-top: 1px solid var(--border-color);
            padding-top: 6px;
            margin-top: 6px;
        }

        /* Top Venues */
        .venues-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 12px;
        }

        .venue-card {
            display: flex;
            align-items: center;
            padding: 16px;
            background: var(--bg-card);
            border-radius: var(--radius-md);
            border: 1px solid var(--border-color);
            cursor: pointer;
            transition: all 0.2s;
        }

        .venue-card:hover {
            border-color: var(--accent-color);
            box-shadow: var(--shadow-md);
            transform: translateY(-2px);
        }

        .venue-rank {
            font-size: 20px;
            font-weight: 700;
            color: var(--accent-color);
            width: 40px;
            text-align: center;
            flex-shrink: 0;
        }

        .venue-rank.top-3 {
            background: var(--accent-light);
            border-radius: 8px;
            padding: 8px;
            margin-right: 12px;
        }

        .venue-info {
            flex: 1;
            min-width: 0;
        }

        .venue-name {
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .venue-meta {
            font-size: 13px;
            color: var(--text-muted);
        }

        .venue-total {
            font-weight: 700;
            color: var(--accent-color);
            font-size: 16px;
            margin-left: 16px;
            white-space: nowrap;
        }

        /* Top Items */
        .items-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .item-chip {
            display: flex;
            align-items: center;
            padding: 10px 16px;
            background: var(--bg-card);
            border-radius: 24px;
            border: 1px solid var(--border-color);
            font-size: 14px;
            transition: all 0.2s;
        }

        .item-chip:hover {
            border-color: var(--accent-color);
            background: var(--accent-light);
        }

        .item-rank {
            background: var(--accent-color);
            color: white;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            margin-right: 10px;
            flex-shrink: 0;
        }

        .item-name {
            max-width: 180px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: var(--text-primary);
        }

        .item-count {
            color: var(--text-muted);
            font-size: 13px;
            margin-left: 10px;
            flex-shrink: 0;
        }

        /* Fun Stats */
        .fun-stats-card {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
            border-radius: var(--radius-lg);
            padding: 28px;
            margin-bottom: 32px;
            color: white;
            box-shadow: var(--shadow-lg);
        }

        .fun-stats-title {
            font-size: 20px;
            font-weight: 600;
            margin: 0 0 24px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .fun-stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
        }

        .fun-stat {
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(10px);
            padding: 20px;
            border-radius: var(--radius-md);
            text-align: center;
            transition: transform 0.2s, background 0.2s;
        }

        .fun-stat:hover {
            transform: translateY(-4px);
            background: rgba(255,255,255,0.2);
        }

        .fun-stat-icon {
            font-size: 32px;
            margin-bottom: 8px;
        }

        .fun-stat-value {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .fun-stat-label {
            font-size: 13px;
            opacity: 0.9;
            margin-bottom: 4px;
        }

        .fun-stat-detail {
            font-size: 11px;
            opacity: 0.7;
        }

        /* Orders Tab */
        .orders-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .date-presets {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .preset-btn {
            padding: 8px 16px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 13px;
            color: var(--text-secondary);
            transition: all 0.2s;
        }

        .preset-btn:hover {
            background: var(--bg-hover);
            border-color: var(--border-dark);
        }

        .preset-btn.active {
            background: var(--accent-color);
            color: white;
            border-color: var(--accent-color);
        }

        .filters-card {
            background: var(--bg-card);
            border-radius: var(--radius-md);
            border: 1px solid var(--border-color);
            padding: 20px;
            margin-bottom: 20px;
        }

        .filters-row {
            display: flex;
            gap: 16px;
            align-items: flex-end;
            flex-wrap: wrap;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .filter-group.grow {
            flex: 1;
            min-width: 200px;
        }

        .filter-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .filter-input {
            padding: 10px 14px;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 14px;
            background: var(--bg-secondary);
            color: var(--text-primary);
            transition: border-color 0.2s;
        }

        .filter-input:focus {
            outline: none;
            border-color: var(--accent-color);
        }

        .filter-actions {
            display: flex;
            gap: 10px;
        }

        .btn {
            padding: 10px 18px;
            border-radius: var(--radius-sm);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-secondary {
            background: var(--bg-hover);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
        }

        .btn-secondary:hover {
            background: var(--border-color);
        }

        .btn-primary {
            background: var(--accent-color);
            border: 1px solid var(--accent-color);
            color: white;
        }

        .btn-primary:hover {
            opacity: 0.9;
        }

        /* Orders Table */
        .orders-summary {
            margin-bottom: 16px;
            font-size: 14px;
            color: var(--text-secondary);
        }

        .orders-summary strong {
            color: var(--text-primary);
        }

        .table-card {
            background: var(--bg-card);
            border-radius: var(--radius-md);
            border: 1px solid var(--border-color);
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            text-align: left;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
        }

        th {
            background: var(--bg-hover);
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            color: var(--text-muted);
        }

        th.sortable {
            cursor: pointer;
            user-select: none;
        }

        th.sortable:hover {
            color: var(--text-primary);
        }

        th.sortable::after {
            content: ' \2195';
            opacity: 0.3;
        }

        th.sortable.asc::after {
            content: ' \2191';
            opacity: 1;
        }

        th.sortable.desc::after {
            content: ' \2193';
            opacity: 1;
        }

        tbody tr {
            transition: background 0.15s;
        }

        tbody tr:hover {
            background: var(--bg-hover);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .order-row {
            cursor: pointer;
        }

        .expand-icon {
            display: inline-block;
            width: 16px;
            margin-right: 8px;
            transition: transform 0.2s;
            color: var(--text-muted);
        }

        .order-row.expanded .expand-icon {
            transform: rotate(90deg);
        }

        .order-details-row {
            display: none;
            background: var(--bg-hover);
        }

        .order-details-row.expanded {
            display: table-row;
        }

        .order-details-cell {
            padding: 20px !important;
        }

        .order-breakdown {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 16px;
        }

        .breakdown-item {
            background: var(--bg-card);
            padding: 14px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
        }

        .breakdown-label {
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .breakdown-value {
            font-weight: 600;
            color: var(--text-primary);
        }

        .currency {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
            font-variant-numeric: tabular-nums;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .container {
                padding: 16px;
            }

            .hero-banner {
                padding: 24px;
            }

            .hero-value {
                font-size: 36px;
            }

            .hero-stat-value {
                font-size: 24px;
            }

            .hero-stats {
                gap: 24px;
            }

            .kpi-grid {
                grid-template-columns: 1fr 1fr;
            }

            .venues-grid {
                grid-template-columns: 1fr;
            }

            .table-card {
                overflow-x: auto;
            }

            table {
                min-width: 600px;
            }
        }

        /* Print Styles */
        @media print {
            body {
                background: white !important;
                padding: 0;
                color: black !important;
            }

            .container {
                max-width: none;
                padding: 0;
            }

            .tabs, .header-actions, .filters-card, .date-presets,
            .btn, .theme-toggle {
                display: none !important;
            }

            .tab-content {
                display: block !important;
            }

            .hero-banner, .fun-stats-card {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .card, .chart-card, .heatmap-card, .table-card {
                break-inside: avoid;
                page-break-inside: avoid;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h1>Wolt Expense Report</h1>
            <div class="header-actions">
                <button class="theme-toggle" onclick="toggleTheme()">
                    <span id="theme-icon">&#127769;</span>
                    <span id="theme-text">Dark</span>
                </button>
            </div>
        </div>

        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab('dashboard')">Dashboard</button>
            <button class="tab-btn" onclick="switchTab('orders')">Orders List</button>
        </div>

        <!-- Dashboard Tab -->
        <div id="dashboard" class="tab-content active">
            <!-- Hero Banner -->
            <div class="hero-banner">
                <div class="hero-content">
                    <div class="hero-main">
                        <div class="hero-label">Lifetime Spending</div>
                        <div class="hero-value" id="hero-total">&#8362;0</div>
                        <div class="hero-subtitle" id="hero-subtitle">Loading...</div>
                    </div>
                    <div class="hero-stats">
                        <div class="hero-stat">
                            <span class="hero-stat-value" id="hero-orders">0</span>
                            <span class="hero-stat-label">Total Orders</span>
                        </div>
                        <div class="hero-stat">
                            <span class="hero-stat-value" id="hero-venues">0</span>
                            <span class="hero-stat-label">Unique Venues</span>
                        </div>
                        <div class="hero-stat">
                            <span class="hero-stat-value" id="hero-avg">&#8362;0</span>
                            <span class="hero-stat-label">Avg Order</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- KPI Cards -->
            <div class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-label">This Year (YTD)</div>
                    <div class="kpi-value currency" id="kpi-ytd">&#8362;0</div>
                    <div class="kpi-trend" id="kpi-ytd-trend"></div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Last 6 Months</div>
                    <div class="kpi-value currency" id="kpi-6m">&#8362;0</div>
                    <div class="kpi-subtitle" id="kpi-6m-avg"></div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Delivery Fees</div>
                    <div class="kpi-value currency" id="kpi-delivery">&#8362;0</div>
                    <div class="kpi-subtitle" id="kpi-delivery-pct"></div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Service Fees</div>
                    <div class="kpi-value currency" id="kpi-service">&#8362;0</div>
                    <div class="kpi-subtitle" id="kpi-service-pct"></div>
                </div>
            </div>

            <!-- Activity Heatmap -->
            <div class="heatmap-card">
                <div class="heatmap-header">
                    <h3 class="heatmap-title">Order Activity (Last 12 Months)</h3>
                </div>
                <div class="heatmap-container">
                    <div class="heatmap-wrapper">
                        <div class="heatmap-months" id="heatmap-months"></div>
                        <div class="heatmap-grid">
                            <div class="heatmap-days-labels">
                                <div class="heatmap-day-label"></div>
                                <div class="heatmap-day-label">Mon</div>
                                <div class="heatmap-day-label"></div>
                                <div class="heatmap-day-label">Wed</div>
                                <div class="heatmap-day-label"></div>
                                <div class="heatmap-day-label">Fri</div>
                                <div class="heatmap-day-label"></div>
                            </div>
                            <div class="heatmap-weeks" id="heatmap-weeks"></div>
                        </div>
                    </div>
                </div>
                <div class="heatmap-footer">
                    <div class="heatmap-stats" id="heatmap-stats"></div>
                    <div class="heatmap-legend">
                        <span>Less</span>
                        <div class="heatmap-legend-item" style="background: var(--border-color);"></div>
                        <div class="heatmap-legend-item" style="background: #9be9a8;"></div>
                        <div class="heatmap-legend-item" style="background: #40c463;"></div>
                        <div class="heatmap-legend-item" style="background: #30a14e;"></div>
                        <div class="heatmap-legend-item" style="background: #216e39;"></div>
                        <span>More</span>
                    </div>
                </div>
            </div>

            <!-- Heatmap Tooltip -->
            <div class="heatmap-tooltip" id="heatmap-tooltip">
                <div class="tooltip-date"></div>
                <div class="tooltip-stats"></div>
                <div class="tooltip-venues"></div>
            </div>

            <!-- Spending Charts -->
            <section class="section">
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="section-title-icon">&#128200;</span>
                        Spending Analysis
                    </h2>
                </div>
                <div class="charts-grid">
                    <div class="chart-card full-width">
                        <h4 class="chart-title">Monthly Spending Trend</h4>
                        <div class="chart-container tall">
                            <canvas id="monthlyTrendChart"></canvas>
                        </div>
                    </div>
                    <div class="chart-card">
                        <h4 class="chart-title">Orders by Day of Week</h4>
                        <div class="chart-container">
                            <canvas id="dayOfWeekChart"></canvas>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Top Venues -->
            <section class="section">
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="section-title-icon">&#127942;</span>
                        Top Venues
                    </h2>
                </div>
                <div class="venues-grid" id="venues-grid"></div>
            </section>

            <!-- Top Items -->
            <section class="section">
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="section-title-icon">&#127828;</span>
                        Most Ordered Items
                    </h2>
                </div>
                <div class="items-grid" id="items-grid"></div>
            </section>

            <!-- Fun Statistics -->
            <div class="fun-stats-card">
                <h3 class="fun-stats-title">
                    <span>&#10024;</span> Fun Statistics
                </h3>
                <div class="fun-stats-grid" id="fun-stats-grid"></div>
            </div>
        </div>

        <!-- Orders Tab -->
        <div id="orders" class="tab-content">
            <div class="orders-header">
                <div class="date-presets">
                    <button class="preset-btn" data-preset="this-month">This Month</button>
                    <button class="preset-btn" data-preset="last-month">Last Month</button>
                    <button class="preset-btn" data-preset="3-months">Last 3 Months</button>
                    <button class="preset-btn" data-preset="6-months">Last 6 Months</button>
                    <button class="preset-btn" data-preset="this-year">This Year</button>
                    <button class="preset-btn" data-preset="last-year">Last Year</button>
                    <button class="preset-btn" data-preset="all">All Time</button>
                </div>
            </div>

            <div class="filters-card">
                <div class="filters-row">
                    <div class="filter-group grow">
                        <label class="filter-label">Search</label>
                        <input type="text" id="search" class="filter-input" placeholder="Search venues, items...">
                    </div>
                    <div class="filter-group">
                        <label class="filter-label">Venue Type</label>
                        <select id="filter-venue-type" class="filter-input">
                            <option value="">All Types</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label class="filter-label">From</label>
                        <input type="date" id="filter-date-from" class="filter-input">
                    </div>
                    <div class="filter-group">
                        <label class="filter-label">To</label>
                        <input type="date" id="filter-date-to" class="filter-input">
                    </div>
                    <div class="filter-actions">
                        <button class="btn btn-secondary" onclick="clearFilters()">Clear</button>
                        <button class="btn btn-primary" onclick="exportFilteredData()">
                            <span>&#128229;</span> Export CSV
                        </button>
                    </div>
                </div>
            </div>

            <div class="orders-summary" id="orders-summary"></div>

            <div class="table-card">
                <table id="orders-table">
                    <thead>
                        <tr>
                            <th class="sortable desc" data-sort="date">Date</th>
                            <th class="sortable" data-sort="venue">Venue</th>
                            <th class="sortable" data-sort="type">Type</th>
                            <th>Items</th>
                            <th class="sortable" data-sort="amount">Amount</th>
                            <th class="sortable" data-sort="status">Status</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        const orders = <%- JSON.stringify(orders) %>;

        const parseAmount = <%- parseAmountFn %>;
        const getOrderDate = <%- getOrderDateFn %>;
        const processData = <%- processDataFn %>;

        // Tab switching
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            document.querySelector(`button[onclick="switchTab('${tabId}')"]`).classList.add('active');
        }

        // Formatting helpers
        function formatCurrency(amount) {
            return `\u20AA${amount.toFixed(2)}`;
        }

        function formatNumber(num) {
            return num.toLocaleString();
        }

        // Color palette
        const CATEGORY_COLORS = {
            'restaurant': '#f43f5e',
            'grocery': '#22c55e',
            'retail': '#3b82f6',
            'drugstore': '#14b8a6',
            'alcohol': '#8b5cf6',
            'florist': '#f97316',
            'electronics': '#06b6d4',
            'home_and_diy': '#64748b',
            'other': '#94a3b8',
            'delivery': '#fbbf24',
            'service_fee': '#a855f7',
            'other_fees': '#6b7280'
        };

        function getCategoryColor(type, index) {
            const key = type.toLowerCase().replace(/\s+/g, '_');
            if (CATEGORY_COLORS[key]) return CATEGORY_COLORS[key];
            const fallback = ['#f43f5e', '#22c55e', '#3b82f6', '#f97316', '#8b5cf6', '#14b8a6', '#eab308', '#ec4899'];
            return fallback[index % fallback.length];
        }

        // Trend calculation
        function getTrendHtml(current, previous) {
            if (previous === 0) return '';
            const change = ((current - previous) / previous) * 100;
            if (Math.abs(change) < 1) return '';
            const isUp = change > 0;
            const cls = isUp ? 'up' : 'down';
            const arrow = isUp ? '\u2191' : '\u2193';
            return `<div class="kpi-trend ${cls}">${arrow} ${Math.abs(change).toFixed(0)}% vs last year</div>`;
        }

        // Populate filters
        function populateFilters(uniqueTypes) {
            const select = document.getElementById('filter-venue-type');
            const currentVal = select.value;
            while (select.options.length > 1) {
                select.remove(1);
            }
            uniqueTypes.forEach(type => {
                const option = document.createElement('option');
                option.value = type;
                option.textContent = type;
                select.appendChild(option);
            });
            if (currentVal) select.value = currentVal;
        }

        // Clear filters
        function clearFilters() {
            document.getElementById('search').value = '';
            document.getElementById('filter-venue-type').value = '';
            document.getElementById('filter-date-from').value = '';
            document.getElementById('filter-date-to').value = '';
            document.querySelectorAll('.preset-btn').forEach(btn => btn.classList.remove('active'));
            renderOrders();
        }

        // Heatmap rendering
        function renderHeatmap(dailyActivity) {
            const weeksContainer = document.getElementById('heatmap-weeks');
            const monthsContainer = document.getElementById('heatmap-months');
            const statsContainer = document.getElementById('heatmap-stats');
            const tooltip = document.getElementById('heatmap-tooltip');

            weeksContainer.innerHTML = '';
            monthsContainer.innerHTML = '';

            const today = new Date();
            const startDate = new Date(today);
            startDate.setDate(startDate.getDate() - 364);
            while (startDate.getDay() !== 0) {
                startDate.setDate(startDate.getDate() - 1);
            }

            const values = Object.values(dailyActivity).map(d => d.total);
            const maxSpending = Math.max(...values, 1);

            const getLevel = (total) => {
                if (total === 0) return 0;
                const ratio = total / maxSpending;
                if (ratio <= 0.25) return 1;
                if (ratio <= 0.5) return 2;
                if (ratio <= 0.75) return 3;
                return 4;
            };

            const monthPositions = [];
            let currentMonth = -1;
            let weekIndex = 0;

            const currentDate = new Date(startDate);
            while (currentDate <= today) {
                const weekDiv = document.createElement('div');
                weekDiv.className = 'heatmap-week';

                if (currentDate.getMonth() !== currentMonth) {
                    currentMonth = currentDate.getMonth();
                    monthPositions.push({
                        month: currentDate.toLocaleString('default', { month: 'short' }),
                        position: weekIndex
                    });
                }

                for (let day = 0; day < 7; day++) {
                    const dayDiv = document.createElement('div');
                    dayDiv.className = 'heatmap-day';

                    if (currentDate <= today) {
                        const dateKey = `${currentDate.getFullYear()}-${String(currentDate.getMonth() + 1).padStart(2, '0')}-${String(currentDate.getDate()).padStart(2, '0')}`;
                        const activity = dailyActivity[dateKey];

                        if (activity && activity.total > 0) {
                            dayDiv.classList.add(`level-${getLevel(activity.total)}`);
                        }

                        dayDiv.dataset.date = dateKey;
                        dayDiv.dataset.total = activity ? activity.total.toFixed(2) : '0';
                        dayDiv.dataset.count = activity ? activity.orderCount : '0';
                        dayDiv.dataset.venues = activity ? activity.venues.join(', ') : '';

                        dayDiv.addEventListener('mouseenter', (e) => {
                            const rect = e.target.getBoundingClientRect();
                            const date = new Date(e.target.dataset.date + 'T00:00:00');
                            const dateStr = date.toLocaleDateString('default', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
                            const total = parseFloat(e.target.dataset.total);
                            const count = parseInt(e.target.dataset.count);
                            const venues = e.target.dataset.venues;

                            tooltip.querySelector('.tooltip-date').textContent = dateStr;

                            if (count > 0) {
                                tooltip.querySelector('.tooltip-stats').innerHTML =
                                    `<strong>${count} order${count > 1 ? 's' : ''}</strong> \u00B7 ${formatCurrency(total)} spent`;
                                tooltip.querySelector('.tooltip-venues').textContent = venues;
                                tooltip.querySelector('.tooltip-venues').style.display = 'block';
                            } else {
                                tooltip.querySelector('.tooltip-stats').textContent = 'No orders';
                                tooltip.querySelector('.tooltip-venues').style.display = 'none';
                            }

                            tooltip.style.left = `${rect.left}px`;
                            tooltip.style.top = `${rect.top - tooltip.offsetHeight - 8}px`;
                            tooltip.classList.add('visible');
                        });

                        dayDiv.addEventListener('mouseleave', () => {
                            tooltip.classList.remove('visible');
                        });

                        dayDiv.addEventListener('click', () => {
                            document.getElementById('search').value = dateKey;
                            switchTab('orders');
                            renderOrders();
                        });
                    }

                    weekDiv.appendChild(dayDiv);
                    currentDate.setDate(currentDate.getDate() + 1);
                }

                weeksContainer.appendChild(weekDiv);
                weekIndex++;
            }

            const totalWeeks = weekIndex;
            monthPositions.forEach((mp, i) => {
                const span = document.createElement('span');
                span.className = 'heatmap-month';
                span.textContent = mp.month;
                const nextPos = monthPositions[i + 1]?.position || totalWeeks;
                span.style.width = `${(nextPos - mp.position) * 15}px`;
                monthsContainer.appendChild(span);
            });

            const totalOrders = Object.values(dailyActivity).reduce((sum, d) => sum + d.orderCount, 0);
            const totalSpent = Object.values(dailyActivity).reduce((sum, d) => sum + d.total, 0);
            const activeDays = Object.values(dailyActivity).filter(d => d.orderCount > 0).length;
            const longestStreak = calculateStreak(dailyActivity, startDate, today);

            statsContainer.innerHTML = `
                <span><strong>${totalOrders}</strong> orders</span>
                <span><strong>${activeDays}</strong> active days</span>
                <span><strong>${longestStreak}</strong> day streak</span>
                <span>Total: <strong>${formatCurrency(totalSpent)}</strong></span>
            `;
        }

        function calculateStreak(dailyActivity, startDate, endDate) {
            let maxStreak = 0;
            let currentStreak = 0;
            const currentDate = new Date(startDate);

            while (currentDate <= endDate) {
                const dateKey = `${currentDate.getFullYear()}-${String(currentDate.getMonth() + 1).padStart(2, '0')}-${String(currentDate.getDate()).padStart(2, '0')}`;
                const activity = dailyActivity[dateKey];

                if (activity && activity.orderCount > 0) {
                    currentStreak++;
                    maxStreak = Math.max(maxStreak, currentStreak);
                } else {
                    currentStreak = 0;
                }

                currentDate.setDate(currentDate.getDate() + 1);
            }

            return maxStreak;
        }

        // Render top venues
        function renderTopVenues(topVenues) {
            const container = document.getElementById('venues-grid');
            container.innerHTML = '';

            topVenues.slice(0, 10).forEach((venue, index) => {
                const card = document.createElement('div');
                card.className = 'venue-card';
                card.innerHTML = `
                    <div class="venue-rank ${index < 3 ? 'top-3' : ''}">#${index + 1}</div>
                    <div class="venue-info">
                        <div class="venue-name">${venue.name}</div>
                        <div class="venue-meta">${venue.orderCount} orders \u00B7 ${venue.type}</div>
                    </div>
                    <div class="venue-total">${formatCurrency(venue.total)}</div>
                `;
                card.addEventListener('click', () => {
                    document.getElementById('search').value = venue.name;
                    switchTab('orders');
                    renderOrders();
                });
                container.appendChild(card);
            });
        }

        // Render top items
        function renderTopItems(topItems) {
            const container = document.getElementById('items-grid');
            container.innerHTML = '';

            if (topItems.length === 0) {
                container.innerHTML = '<div style="color: var(--text-muted); padding: 20px;">No item data available</div>';
                return;
            }

            topItems.slice(0, 10).forEach((item, index) => {
                const chip = document.createElement('div');
                chip.className = 'item-chip';
                chip.innerHTML = `
                    <div class="item-rank">${index + 1}</div>
                    <div class="item-name" title="${item.name}">${item.name}</div>
                    <div class="item-count">\u00D7${item.count}</div>
                `;
                container.appendChild(chip);
            });
        }

        // Distance metaphor
        function distanceMetaphor(meters) {
            const km = meters / 1000;
            if (km < 10) return 'Just getting started!';
            if (km < 50) return 'Like walking across a city';
            if (km < 100) return 'A nice bike ride';
            if (km < 300) return 'Tel Aviv to Haifa';
            if (km < 500) return 'Across Israel';
            return 'Impressive distance!';
        }

        // Render fun stats
        function renderFunStats(data) {
            const container = document.getElementById('fun-stats-grid');
            container.innerHTML = '';

            const stats = [
                {
                    icon: '\uD83D\uDCC5',
                    value: data.favoriteDay.name,
                    label: 'Favorite Day',
                    detail: `${data.favoriteDay.orderCount} orders`
                },
                {
                    icon: '\uD83C\uDFC6',
                    value: formatCurrency(data.biggestOrder.amount),
                    label: 'Biggest Order',
                    detail: `at ${data.biggestOrder.venue}`
                },
                {
                    icon: '\uD83C\uDF19',
                    value: data.lateNightOrders,
                    label: 'Late Night Orders',
                    detail: 'After 10pm'
                },
                {
                    icon: '\uD83C\uDF7D\uFE0F',
                    value: formatNumber(data.totalItemsCount),
                    label: 'Items Ordered',
                    detail: 'All time'
                },
                {
                    icon: '\uD83D\uDE97',
                    value: `${(data.ytdDistance / 1000).toFixed(0)} km`,
                    label: 'Distance (YTD)',
                    detail: distanceMetaphor(data.ytdDistance)
                }
            ];

            stats.forEach(stat => {
                const card = document.createElement('div');
                card.className = 'fun-stat';
                card.innerHTML = `
                    <div class="fun-stat-icon">${stat.icon}</div>
                    <div class="fun-stat-value">${stat.value}</div>
                    <div class="fun-stat-label">${stat.label}</div>
                    <div class="fun-stat-detail">${stat.detail}</div>
                `;
                container.appendChild(card);
            });
        }

        // Sorting state
        let currentSort = { column: 'date', direction: 'desc' };
        let currentFilteredData = [];

        // Main dashboard render
        function renderDashboard() {
            try {
                const data = processData(orders);
                populateFilters(data.uniqueVenueTypes);

                // Use all-time totals for accurate calculations
                const lifetimeTotal = data.allTimeTotal;
                const uniqueVenuesCount = data.uniqueVenueCount;

                // Hero Banner
                document.getElementById('hero-total').textContent = formatCurrency(lifetimeTotal);
                document.getElementById('hero-subtitle').textContent = `Across ${data.totalOrderCount.toLocaleString()} orders from ${uniqueVenuesCount} venues`;
                document.getElementById('hero-orders').textContent = formatNumber(data.totalOrderCount);
                document.getElementById('hero-venues').textContent = uniqueVenuesCount;
                document.getElementById('hero-avg').textContent = formatCurrency(data.avgOrderValue);

                // KPI Cards
                document.getElementById('kpi-ytd').textContent = formatCurrency(data.ytdTotal);
                document.getElementById('kpi-ytd-trend').innerHTML = getTrendHtml(data.ytdTotal, data.lastYearTotal);
                document.getElementById('kpi-6m').textContent = formatCurrency(data.last6MonthsTotal);
                document.getElementById('kpi-6m-avg').textContent = `~${formatCurrency(data.last6MonthsTotal / 6)}/month`;
                document.getElementById('kpi-delivery').textContent = formatCurrency(data.totalDeliveryFees);
                const deliveryPct = lifetimeTotal > 0 ? ((data.totalDeliveryFees / lifetimeTotal) * 100).toFixed(1) : 0;
                document.getElementById('kpi-delivery-pct').textContent = `${deliveryPct}% of total`;
                document.getElementById('kpi-service').textContent = formatCurrency(data.totalServiceFees);
                const servicePct = lifetimeTotal > 0 ? ((data.totalServiceFees / lifetimeTotal) * 100).toFixed(1) : 0;
                document.getElementById('kpi-service-pct').textContent = `${servicePct}% of total`;

                // Heatmap
                renderHeatmap(data.dailyActivity);

                // Top Venues & Items
                renderTopVenues(data.topVenues);
                renderTopItems(data.topItems);

                // Fun Stats
                renderFunStats(data);

                // Chart 1: Monthly Trend (Stacked Bar with categories)
                const monthlyLabels = data.monthly.map(m => m.label);

                // Build stacked datasets from stackedTypes
                const stackedDatasets = data.stackedTypes.map((type, idx) => ({
                    label: type,
                    data: data.monthly.map(m => m.byType[type] || 0),
                    backgroundColor: getCategoryColor(type, idx),
                    borderRadius: idx === data.stackedTypes.length - 1 ? { topLeft: 4, topRight: 4 } : 0,
                    borderSkipped: false
                }));

                new Chart(document.getElementById('monthlyTrendChart'), {
                    type: 'bar',
                    data: {
                        labels: monthlyLabels,
                        datasets: stackedDatasets
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: true,
                                position: 'bottom',
                                labels: { boxWidth: 12, padding: 12, usePointStyle: true }
                            },
                            tooltip: {
                                mode: 'index',
                                callbacks: {
                                    label: (ctx) => `${ctx.dataset.label}: ${formatCurrency(ctx.raw)}`,
                                    footer: (items) => {
                                        const total = items.reduce((sum, item) => sum + item.raw, 0);
                                        return `Total: ${formatCurrency(total)}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: { stacked: true },
                            y: {
                                stacked: true,
                                beginAtZero: true,
                                ticks: {
                                    callback: (val) => `\u20AA${val}`
                                }
                            }
                        }
                    }
                });

                // Chart 2: Day of Week
                const dayColors = data.dayOfWeekBreakdown.map((d, i) =>
                    d.day === data.favoriteDay.name.substring(0, 3) ? '#6366f1' : 'rgba(100, 116, 139, 0.5)'
                );

                new Chart(document.getElementById('dayOfWeekChart'), {
                    type: 'bar',
                    data: {
                        labels: data.dayOfWeekBreakdown.map(d => d.day),
                        datasets: [{
                            label: 'Orders',
                            data: data.dayOfWeekBreakdown.map(d => d.orders),
                            backgroundColor: dayColors,
                            borderRadius: 6,
                            borderSkipped: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });

            } catch (error) {
                console.error('Error rendering dashboard:', error);
            }
        }

        // Orders table render
        function renderOrders() {
            try {
                const tbody = document.querySelector('#orders-table tbody');
                const searchText = document.getElementById('search').value.toLowerCase();
                const filterVenueType = document.getElementById('filter-venue-type').value;
                const filterDateFrom = document.getElementById('filter-date-from').value;
                const filterDateTo = document.getElementById('filter-date-to').value;

                let count = 0;
                let totalFiltered = 0;
                const filteredOrders = [];

                orders.forEach(order => {
                    const venue = order.venue_name || 'Unknown';
                    const type = (order.details && order.details.venue_product_line) ? order.details.venue_product_line : 'Other';

                    // Get items from multiple possible locations
                    let orderItems = null;
                    if (Array.isArray(order.items) && order.items.length > 0) {
                        orderItems = order.items;
                    } else if (order.details) {
                        if (Array.isArray(order.details.order_items) && order.details.order_items.length > 0) {
                            orderItems = order.details.order_items;
                        } else if (Array.isArray(order.details.items) && order.details.items.length > 0) {
                            orderItems = order.details.items;
                        } else if (Array.isArray(order.details.purchases) && order.details.purchases.length > 0) {
                            orderItems = order.details.purchases;
                        }
                    }

                    let itemsDisplay = '';
                    if (orderItems) {
                        itemsDisplay = orderItems
                            .map(i => i?.name || i?.product_name || i?.item_name || '')
                            .filter(n => n)
                            .join(', ');
                    } else if (typeof order.items === 'string') {
                        itemsDisplay = order.items;
                    }

                    const dateObj = getOrderDate(order);
                    const isoDate = !isNaN(dateObj.getTime()) ? dateObj.toISOString().split('T')[0] : 'N/A';
                    const amountNum = parseAmount(order.total_amount || '0');

                    // Filters
                    if (searchText &&
                        !venue.toLowerCase().includes(searchText) &&
                        !itemsDisplay.toLowerCase().includes(searchText) &&
                        !isoDate.includes(searchText)) {
                        return;
                    }

                    if (filterVenueType && type !== filterVenueType) return;
                    if (filterDateFrom && isoDate < filterDateFrom) return;
                    if (filterDateTo && isoDate > filterDateTo) return;

                    const ignoredStatuses = ['deferred_payment_failed', 'rejected', 'pending_transaction'];
                    if (ignoredStatuses.includes(order.status)) return;

                    let itemsPrice = 0, deliveryPrice = 0, serviceFee = 0;
                    if (order.details) {
                        const getAmt = (val) => typeof val === 'number' ? val / 100 : parseAmount(val);
                        itemsPrice = getAmt(order.details.items_price) || 0;
                        deliveryPrice = getAmt(order.details.delivery_base_price) || 0;
                        serviceFee = getAmt(order.details.service_fee) || 0;
                    }

                    filteredOrders.push({
                        date: isoDate,
                        dateObj,
                        venue,
                        type,
                        itemsDisplay,
                        amount: amountNum,
                        status: order.status,
                        items: orderItems || [],
                        itemsPrice,
                        deliveryPrice,
                        serviceFee,
                        distance: order.details?.delivery_distance || 0
                    });
                });

                // Sort
                filteredOrders.sort((a, b) => {
                    let valA, valB;
                    switch (currentSort.column) {
                        case 'date': valA = a.dateObj; valB = b.dateObj; break;
                        case 'venue': valA = a.venue.toLowerCase(); valB = b.venue.toLowerCase(); break;
                        case 'type': valA = a.type.toLowerCase(); valB = b.type.toLowerCase(); break;
                        case 'amount': valA = a.amount; valB = b.amount; break;
                        case 'status': valA = a.status.toLowerCase(); valB = b.status.toLowerCase(); break;
                        default: return 0;
                    }
                    let result = valA < valB ? -1 : valA > valB ? 1 : 0;
                    return currentSort.direction === 'asc' ? result : -result;
                });

                // Render
                tbody.innerHTML = '';
                currentFilteredData = filteredOrders;

                filteredOrders.forEach((order, index) => {
                    count++;
                    totalFiltered += order.amount;

                    const tr = document.createElement('tr');
                    tr.className = 'order-row';
                    tr.innerHTML = `
                        <td><span class="expand-icon">\u25B6</span> ${order.date}</td>
                        <td>${order.venue}</td>
                        <td>${order.type}</td>
                        <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${order.itemsDisplay}">${order.itemsDisplay}</td>
                        <td class="currency">${formatCurrency(order.amount)}</td>
                        <td>${order.status}</td>
                    `;

                    const detailsTr = document.createElement('tr');
                    detailsTr.className = 'order-details-row';

                    let itemsList = '';
                    if (Array.isArray(order.items) && order.items.length > 0) {
                        itemsList = order.items
                            .map(i => i?.name || i?.product_name || i?.item_name || '')
                            .filter(n => n)
                            .map(name => `<li>${name}</li>`)
                            .join('');
                    }

                    detailsTr.innerHTML = `
                        <td colspan="6" class="order-details-cell">
                            <div class="order-breakdown">
                                <div class="breakdown-item">
                                    <div class="breakdown-label">Items Price</div>
                                    <div class="breakdown-value">${formatCurrency(order.itemsPrice)}</div>
                                </div>
                                <div class="breakdown-item">
                                    <div class="breakdown-label">Delivery Fee</div>
                                    <div class="breakdown-value">${formatCurrency(order.deliveryPrice)}</div>
                                </div>
                                <div class="breakdown-item">
                                    <div class="breakdown-label">Service Fee</div>
                                    <div class="breakdown-value">${formatCurrency(order.serviceFee)}</div>
                                </div>
                                <div class="breakdown-item">
                                    <div class="breakdown-label">Distance</div>
                                    <div class="breakdown-value">${(order.distance / 1000).toFixed(1)} km</div>
                                </div>
                            </div>
                            ${itemsList ? `<div style="margin-top: 16px;"><strong>Items:</strong><ul style="margin: 8px 0; padding-left: 20px;">${itemsList}</ul></div>` : ''}
                        </td>
                    `;

                    tr.addEventListener('click', () => {
                        tr.classList.toggle('expanded');
                        detailsTr.classList.toggle('expanded');
                    });

                    tbody.appendChild(tr);
                    tbody.appendChild(detailsTr);
                });

                document.getElementById('orders-summary').innerHTML =
                    `Showing <strong>${count}</strong> orders \u00B7 Total: <strong>${formatCurrency(totalFiltered)}</strong>`;
            } catch (error) {
                console.error('Error rendering orders:', error);
            }
        }

        // Date presets
        function applyDatePreset(preset) {
            const today = new Date();
            let fromDate, toDate;

            switch (preset) {
                case 'this-month':
                    fromDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    toDate = today;
                    break;
                case 'last-month':
                    fromDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                    toDate = new Date(today.getFullYear(), today.getMonth(), 0);
                    break;
                case '3-months':
                    fromDate = new Date(today.getFullYear(), today.getMonth() - 2, 1);
                    toDate = today;
                    break;
                case '6-months':
                    fromDate = new Date(today.getFullYear(), today.getMonth() - 5, 1);
                    toDate = today;
                    break;
                case 'this-year':
                    fromDate = new Date(today.getFullYear(), 0, 1);
                    toDate = today;
                    break;
                case 'last-year':
                    fromDate = new Date(today.getFullYear() - 1, 0, 1);
                    toDate = new Date(today.getFullYear() - 1, 11, 31);
                    break;
                case 'all':
                    fromDate = null;
                    toDate = null;
                    break;
            }

            document.getElementById('filter-date-from').value = fromDate ? fromDate.toISOString().split('T')[0] : '';
            document.getElementById('filter-date-to').value = toDate ? toDate.toISOString().split('T')[0] : '';

            document.querySelectorAll('.preset-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelector(`.preset-btn[data-preset="${preset}"]`)?.classList.add('active');

            renderOrders();
        }

        // Sort handling
        function handleSort(column) {
            if (currentSort.column === column) {
                currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
            } else {
                currentSort.column = column;
                currentSort.direction = 'desc';
            }

            document.querySelectorAll('th.sortable').forEach(th => {
                th.classList.remove('asc', 'desc');
                if (th.dataset.sort === currentSort.column) {
                    th.classList.add(currentSort.direction);
                }
            });

            renderOrders();
        }

        // Export CSV
        function exportFilteredData() {
            if (currentFilteredData.length === 0) {
                alert('No data to export');
                return;
            }

            let csv = 'Date,Venue,Type,Items,Amount,Status\n';

            currentFilteredData.forEach(order => {
                const escape = (str) => {
                    if (str.includes(',') || str.includes('"')) {
                        return '"' + str.replace(/"/g, '""') + '"';
                    }
                    return str;
                };

                csv += [
                    escape(order.date),
                    escape(order.venue),
                    escape(order.type),
                    escape(order.itemsDisplay),
                    order.amount.toFixed(2),
                    escape(order.status)
                ].join(',') + '\n';
            });

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `wolt-orders-${new Date().toISOString().split('T')[0]}.csv`;
            link.click();
        }

        // Theme toggle
        function toggleTheme() {
            const html = document.documentElement;
            const newTheme = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';

            html.setAttribute('data-theme', newTheme === 'dark' ? 'dark' : '');
            document.getElementById('theme-icon').textContent = newTheme === 'dark' ? '\u2600\uFE0F' : '\uD83C\uDF19';
            document.getElementById('theme-text').textContent = newTheme === 'dark' ? 'Light' : 'Dark';

            localStorage.setItem('wolt-report-theme', newTheme);
            updateChartColors(newTheme);
        }

        function updateChartColors(theme) {
            Chart.defaults.color = theme === 'dark' ? '#94a3b8' : '#64748b';
            Chart.defaults.borderColor = theme === 'dark' ? '#334155' : '#e2e8f0';
        }

        function loadThemePreference() {
            const savedTheme = localStorage.getItem('wolt-report-theme');
            if (savedTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
                document.getElementById('theme-icon').textContent = '\u2600\uFE0F';
                document.getElementById('theme-text').textContent = 'Light';
                updateChartColors('dark');
            }
        }

        // Event listeners
        document.getElementById('search').addEventListener('input', renderOrders);
        document.getElementById('filter-venue-type').addEventListener('change', renderOrders);
        document.getElementById('filter-date-from').addEventListener('change', () => {
            document.querySelectorAll('.preset-btn').forEach(btn => btn.classList.remove('active'));
            renderOrders();
        });
        document.getElementById('filter-date-to').addEventListener('change', () => {
            document.querySelectorAll('.preset-btn').forEach(btn => btn.classList.remove('active'));
            renderOrders();
        });

        document.querySelectorAll('.preset-btn').forEach(btn => {
            btn.addEventListener('click', () => applyDatePreset(btn.dataset.preset));
        });

        document.querySelectorAll('th.sortable').forEach(th => {
            th.addEventListener('click', () => handleSort(th.dataset.sort));
        });

        // Initialize
        loadThemePreference();
        renderDashboard();
        renderOrders();
    </script>
</body>

</html>
